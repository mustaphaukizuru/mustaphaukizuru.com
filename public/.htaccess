# =============================================================================
# Apache configuration for the static error pages
#
# Why this file exists:
#   When the Node.js app is unreachable (Passenger restart, OOM kill, crash
#   loop), Apache serves the request itself instead of proxying to Node.
#   Without ErrorDocument directives, visitors see Hostinger's generic
#   "503 Service Unavailable" page. With this file, they see our branded
#   503.html living next to it in /public.
#
#   The 5xx family points to 503.html because the message is the same in
#   all three cases: "we're temporarily unreachable, try again."
#
#   The 404 / 500 directives mostly bind for direct file requests that
#   bypass Node (e.g. /typo.html). When Node is up, the Express middleware
#   in src/middleware/notFound.js + errorHandler.js handles application-
#   level 404 / 500 with the SAME branded HTML so the experience is
#   identical regardless of which layer handled it.
# =============================================================================

ErrorDocument 404 /404.html
ErrorDocument 500 /500.html
ErrorDocument 502 /503.html
ErrorDocument 503 /503.html
ErrorDocument 504 /503.html

# Make sure Apache can serve the error pages directly even when an outer
# rewrite would normally send everything to the Node app. Without these
# RewriteCond exclusions, the ErrorDocument would itself become 503 in a
# loop when Node is dead.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(404|500|503)\.html$ - [L]

  # Maintenance window (T1-1). scripts/deploy.sh touches public/maintenance.flag
  # before restarting the app and removes it once the health gate passes, so
  # visitors see the branded 503 page for the seconds Passenger needs instead
  # of a hung request. R=503 with "-" returns the status and stops; the
  # ErrorDocument above then serves 503.html. The error pages themselves are
  # excluded so that internal subrequest is not answered 503 in a loop.
  # THIS FILE IS THE SOURCE: Vite copies web/public/ into the repo-root
  # public/ on every build, so editing only public/.htaccess is undone by
  # the next `npm run build:seo`.
  RewriteCond %{DOCUMENT_ROOT}/maintenance.flag -f
  RewriteCond %{REQUEST_URI} !^/(404|500|503)\.html$
  RewriteRule ^ - [R=503,L]

  # ── Canonical URL (T2-6) ────────────────────────────────────────────────
  # One URL per page, or the same content competes with itself in the index
  # and every share link splits its signals across variants. These sit AFTER
  # the maintenance rule on purpose: during a deploy window a request should
  # get the 503 immediately, not a redirect to a host that is also 503.
  #
  # Ordered https → apex → trailing slash so a request needing all three is
  # normalised in three hops at most, each one permanent and cacheable.

  # 1 · https. The host already does this at the edge; stating it here means
  # the rule survives a proxy or CDN change that stops doing it silently.
  # X-Forwarded-Proto is checked too: behind a terminating proxy %{HTTPS} is
  # "off" for an already-secure request, and redirecting that is a loop.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # 2 · apex, not www. Chosen because every canonical, hreflang and OG URL
  # the app emits is apex (web/src/seo/siteSeo.js SITE_URL), so www would
  # contradict the page's own canonical tag.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # 3 · no trailing slash, except the root. `!-d` keeps real directories
  # working: Apache serves a directory only when the URL ends in a slash, so
  # stripping it unconditionally would break /assets/ and anything else that
  # exists on disk. QSA preserves campaign parameters through the redirect —
  # dropping utm_* on a canonicalisation is how attribution goes missing.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L,QSA]
</IfModule>

# Standard caching headers — the error pages rarely change, but we don't
# want them cached aggressively while we're iterating on the design.
<IfModule mod_headers.c>
  <FilesMatch "^(404|500|503)\.html$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>
