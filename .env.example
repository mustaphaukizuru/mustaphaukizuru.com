# =============================================================================
#  mustaphaukizuru.com · Backend environment template
#  Copy to .env (local dev) or .env.production (live) and fill in real values.
#  NEVER commit filled-in copies. See SECURITY.md.
# =============================================================================

# ── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
LOG_LEVEL=debug

# ── Frontend / Client URLs ──────────────────────────────────────────────────
# Used by backend for CORS, redirect targets, email links, OAuth callbacks.
# CLIENT_URL is REQUIRED (B11) — server refuses to boot without it.
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:5000
# Public origin of the API, used to build absolute links in emails
# (newsletter confirm / unsubscribe). BACKEND_URL wins; API_BASE_URL is the
# fallback. Production: https://mustaphaukizuru.com
BACKEND_URL=http://localhost:5000
API_BASE_URL=http://localhost:5000
# Canonical public site origin — OG injection (ogInjector), email footers,
# campaign preview links. No trailing slash.
PUBLIC_SITE_URL=http://localhost:5173

# ── Database (Prisma / MySQL) ───────────────────────────────────────────────
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Local dev should use a non-production database.
#
# Production note (Hostinger / any shared MySQL):
#   Hostinger's MySQL kills idle TCP connections after ~60s (wait_timeout).
#   Without query-string tuning, Prisma's pool will grab a dead socket the
#   first time a low-frequency cron fires and panic with
#   "PANIC: timer has gone away". Append these params in production:
#
#     ?connection_limit=2&pool_timeout=10&connect_timeout=10
#
#   - connection_limit=2  → fewer sockets to keep alive (shared host quotas
#                           are tiny anyway; 2 is plenty for one Node proc)
#   - pool_timeout=10     → fail fast when the pool is exhausted instead of
#                           hanging the request
#   - connect_timeout=10  → fail fast on initial handshake instead of the
#                           default 30s wait that causes lambda-like crashes
#
#   The cron code also pings (SELECT 1) and recycles the engine on stale
#   sockets — see src/lib/prisma.js (isAlive / recycle helpers) — but the
#   URL params are a belt-and-suspenders layer that prevents wasted retries.
DATABASE_URL=<SET_ME>

# ── Authentication (JWT + session cookie) ───────────────────────────────────
# B10: minimum 64 chars enforced at boot. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<SET_ME>
JWT_EXPIRES_IN=7d
#
# Step 40 · the session JWT is delivered in an httpOnly cookie (`mu_session`)
# paired with a readable CSRF cookie (`mu_csrf`). There is NO extra secret to
# configure — the cookies are unsigned by design (the session cookie holds a
# JWT that authenticates itself, the CSRF cookie is a random nonce compared
# against an X-CSRF-Token header). Two existing variables do govern them:
#
#   NODE_ENV=production  → both cookies gain the `Secure` flag. Anything else
#                          (development / test) omits it so http://localhost
#                          works. Never run production without it.
#   JWT_EXPIRES_IN       → keep in step with the cookie lifetime in
#                          src/utils/sessionCookie.js (7d default, 30d with
#                          rememberMe); a cookie that outlives its JWT just
#                          produces confusing 401s.
#
# Cookies are set with SameSite=Lax and Path=/, which assumes the SPA and the
# API share an origin in production. If you ever split them onto different
# sites, Lax cookies stop being sent and this design needs revisiting.

# ── Google OAuth ────────────────────────────────────────────────────────────
# Used by Google Sign-In. The current primary path is OAuth Authorization
# Code redirect flow (NOT One-Tap) — same pattern GitHub, Linear, Vercel,
# Notion use. Eliminates the third-party-cookie requirement and the Brave
# "Access other apps" prompt that One-Tap triggers.
#
# Both values come from a single OAuth 2.0 Client ID created at:
#   https://console.cloud.google.com/apis/credentials
#   → "+ CREATE CREDENTIALS" → "OAuth client ID" → "Web application"
#
# REQUIRED FIELDS on the OAuth client:
#
#   Authorised JavaScript origins:
#     https://mustaphaukizuru.com
#     http://localhost:5173                ← Vite dev
#
#   Authorised redirect URIs (NEW — required for the redirect flow):
#     https://mustaphaukizuru.com/api/auth/google/callback
#     http://localhost:5000/api/auth/google/callback   ← API dev port
#
# Existing One-Tap callers (the legacy POST /api/auth/google route) still
# work — they're kept for backwards compatibility — but the SPA now uses
# the redirect flow by default. You can delete One-Tap support once all
# clients have migrated.
#
# GOOGLE_CLIENT_SECRET is REQUIRED for the redirect flow. It's used
# server-side only (during the code-for-tokens exchange) and is never
# exposed to the browser. Treat it like a JWT secret. NEVER commit it.
# Frontend also needs VITE_GOOGLE_CLIENT_ID in web/.env (client_id is
# semi-public, client_secret is NOT — keep the secret on the API host only).
GOOGLE_CLIENT_ID=<SET_ME>
GOOGLE_CLIENT_SECRET=<SET_ME>

# OAUTH_REDIRECT_URI — strongly recommended in production.
#
# The redirect_uri sent to Google's token endpoint MUST byte-identically
# match (a) the one we sent on the initial /start hop, (b) the one in
# Google Cloud Console, (c) the one we send on the /callback exchange.
# Any difference — trailing slash, http vs https, www vs apex —
# produces `invalid_grant` and a hard-failed sign-in.
#
# Without this var, the API derives the URI from request headers
# (X-Forwarded-Proto, X-Forwarded-Host). On Hostinger / cPanel / Plesk
# / any shared host with an Apache reverse proxy in front of Node, those
# headers are inconsistent — the derived URI often comes out as `http://`
# while Google has `https://` registered, breaking sign-in.
#
# Set this to the EXACT string you registered in Google Cloud Console
# under "Authorised redirect URIs":
#
#   OAUTH_REDIRECT_URI=https://mustaphaukizuru.com/api/auth/google/callback
#
# Leave it unset only in local dev where Node serves directly without a
# proxy and `req.headers.host` returns the right value naturally.
OAUTH_REDIRECT_URI=

# Frontend-style alias read by googleAuthService as a fallback for
# GOOGLE_CLIENT_ID (handy when the API shares web/.env on the same host).
VITE_GOOGLE_CLIENT_ID=

# ── Microsoft OAuth (optional — "Sign in with Microsoft") ───────────────────
# Sign-in is disabled when either value is empty. Register an app at
# https://portal.azure.com → App registrations (web platform).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Exact redirect URI registered in Azure; derived from request headers when
# unset (unreliable behind Hostinger's proxy — set it in production):
#   https://mustaphaukizuru.com/api/auth/microsoft/callback
MICROSOFT_OAUTH_REDIRECT_URI=

# ── Facebook OAuth (optional — "Sign in with Facebook") ─────────────────────
# Sign-in is disabled when either value is empty. https://developers.facebook.com
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
#   https://mustaphaukizuru.com/api/auth/facebook/callback
FACEBOOK_OAUTH_REDIRECT_URI=

# ── MercadoPago (LATAM payments, primary) ───────────────────────────────────
# Use TEST-prefixed credentials in development.
MP_ACCESS_TOKEN=<SET_ME>
MP_PUBLIC_KEY=<SET_ME>
# Required to verify webhook signatures — must NOT be empty in production.
MP_WEBHOOK_SECRET=<SET_ME>

# ── PayPal (International payments) ─────────────────────────────────────────
# Live base URL:    https://api-m.paypal.com   (default — used when var is unset)
# Sandbox base URL: https://api-m.sandbox.paypal.com
# Leave PAYPAL_BASE_URL blank in production to inherit the live default; only
# set it explicitly when you're pointing dev at sandbox.
PAYPAL_CLIENT_ID=<SET_ME>
PAYPAL_CLIENT_SECRET=<SET_ME>
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# REQUIRED in production when PAYPAL_CLIENT_ID is set — the boot pre-flight in
# config/env.js refuses to start otherwise. Source: Developer Dashboard →
# your app → Webhooks → the webhook entry has a "Webhook ID" field.
PAYPAL_WEBHOOK_ID=<SET_ME>

# ── Email / SMTP (Hostinger) ────────────────────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
# 'true' (default) uses implicit TLS on 465; set 'false' to downgrade to
# STARTTLS on 587. Anything other than the literal 'false' is treated as true.
SMTP_SECURE=true
SMTP_USER=<SET_ME>
SMTP_PASS=<SET_ME>
# Reply-to / support inbox surfaced in email footers. Falls back to SMTP_USER.
SUPPORT_EMAIL=hello@mustaphaukizuru.com
# Domain emails fetch the brand logo from (must serve /images/profile/*).
EMAIL_LOGO_DOMAIN=https://mustaphaukizuru.com
# Inbox that receives contact-form submissions and diagnostic reports.
# Falls back to SMTP_USER.
CONTACT_ADMIN_EMAIL=hello@mustaphaukizuru.com

# ── B11 · Error tracking (Sentry — free tier, recommended in production) ───
#
# Empty value = Sentry is fully disabled. The app boots fine and prints
# `⚠️ Optional services missing: SENTRY_DSN not set (error tracking disabled)`
# in the logs. That's not an error — it's a heads-up that crash reports
# from src/middleware/errorHandler.js, the ErrorBoundary, and the booking
# cron's catch blocks are currently being silently dropped. Without a DSN
# you have no one watching for production crashes.
#
# Why Sentry's free "Developer" tier is the right choice here:
#   · $0/month forever — no credit card, no trial expiry
#   · 5,000 errors/month + 10,000 performance events
#   · Sentry de-duplicates by stack trace, so e.g. yesterday's Prisma
#     panic that fired ~500 times shows up as ONE issue
#   · This codebase already sets tracesSampleRate=0.1 in production,
#     so you'll realistically use 100–400 events/month
#   · Headers `authorization` and `cookie` are stripped before send
#     (see src/lib/sentry.js beforeSend hook), so JWTs never leak
#
# Setup (10 minutes, one time):
#   1. Sign up at https://sentry.io/signup/ — pick "Node.js + Express"
#   2. Sentry shows a DSN that looks like:
#        https://abc123@o1234567.ingest.us.sentry.io/9876543
#      Copy it. Treat it like a public-ish token: anyone with the DSN
#      could post fake errors to your project but cannot read your data.
#   3. On Hostinger panel → Node.js → Environment, add:
#        SENTRY_DSN=<paste your DSN>
#        SENTRY_ENVIRONMENT=production
#      (SENTRY_TRACES_SAMPLE_RATE defaults to 0.1 in production — keep it.)
#   4. Restart the Node app. You should now see in the boot logs:
#        [sentry] initialised · env=production · tracesSampleRate=0.1
#      instead of the "not set" warning.
#   5. Smoke test: throw a temporary error in a route, hit it once,
#      remove the throw. Within ~30s the error appears in your Sentry
#      dashboard → Issues. If it doesn't, the DSN is wrong.
#
# When you'd outgrow the free tier:
#   · You're consistently > 5,000 events/month even with sampling
#   · You need 2+ team members on the dashboard
#   · You need > 30-day retention for compliance reasons
#   At that point the Team tier is $26/month. Until then, free is fine.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
# Release tag attached to Sentry events. Defaults to the current git SHA
# when unset (src/lib/sentry.js).
SENTRY_RELEASE=

# ── B11 · Backups (optional) ────────────────────────────────────────────────
# Override these only if your Hostinger MySQL host needs a non-default mysqldump
# binary path. The backup script auto-detects /usr/bin/mysqldump otherwise.
# MYSQLDUMP_BIN=/usr/bin/mysqldump

# ── Analytics (first-party, src/services/analyticsService.js) ──────────────
# Secret salt for hashing visitor IPs / session ids before storage. Any long
# random string; rotate to invalidate historical session linkage.
ANALYTICS_HASH_SALT=<SET_ME>

# ── Google Calendar / Meet integration (REQUIRED in production) ─────────────
# Powers auto-creation of Google Meet links when a client books a consultation.
#
# When ANY of these is unset, bookings still succeed but the row is saved
# with meetingLink=null and meetingProvider="manual" — the admin must paste a
# link manually from /admin/consultations before the client can join.
# There is NO automatic fallback to Jitsi (removed in Phase 11 polish to keep
# the customer experience consistent on a single provider).
#
# The five env vars + their setup notes live in their own focused file:
#   config/google-meet.env.template
# And the full Cloud-Console walk-through lives at:
#   docs/google-meet-setup.md
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_CALENDAR_HOST_EMAIL=hello@mustaphaukizuru.com
GOOGLE_CALENDAR_ID=primary
# Used ONLY by scripts/google-oauth-bootstrap.js to issue the refresh token.
# Must match a redirect URI registered in the Google Cloud Console for the
# OAuth client. Does NOT need to be a real route — the bootstrap captures
# the code by manual paste, not by hosting a callback.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/api/v1/admin/google/oauth-callback

# ── Booking (optional) ──────────────────────────────────────────────────────
# Pin a specific user id as the booking host. When unset, availability falls
# back to Service.createdById, then to the alphabetically-first active admin.
# Useful when you have multiple admins and want bookings to land with a
# specific one regardless of which service the customer chose.
DEFAULT_HOST_USER_ID=

# ── Client portal ───────────────────────────────────────────────────────────
# Comma-separated origins allowed to be embedded as a project "live preview"
# iframe (added to CSP frame-src). Any other previewUrl is shown as a link.
# e.g. https://*.vercel.app,https://staging.mustaphaukizuru.com
PREVIEW_FRAME_HOSTS=
# Days after a project closes (completed/cancelled) during which the client
# can still read it. After that the portal returns 410 for that project.
PROJECT_ACCESS_GRACE_DAYS=30
# Days after a project closes before projectPurgeJob (04:00 UTC) deletes its
# files from disk. Rows keep their metadata with purgedAt set. Default 60.
PROJECT_PURGE_DAYS=60

# ── Operations ──────────────────────────────────────────────────────────────
# Set DISABLE_CRON=1 on staging / preview environments to silence the
# scheduled jobs (analytics aggregation, booking reminders, campaign sender)
# so they don't fire on a non-production database.
DISABLE_CRON=
# Process timezone for cron schedules and log timestamps. The analytics
# rollup pins UTC explicitly; everything else follows TZ.
TZ=UTC
