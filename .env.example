# =============================================================================
#  mustaphaukizuru.com · Backend environment template
#  Copy to .env (local dev) or .env.production (live) and fill in real values.
#  NEVER commit filled-in copies. See SECURITY.md.
# =============================================================================

# ── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
LOG_LEVEL=debug

# ── Frontend / Client URLs ──────────────────────────────────────────────────
# Used by backend for CORS, redirect targets, email links, OAuth callbacks.
# CLIENT_URL is REQUIRED (B11) — server refuses to boot without it.
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:5000
DOWNLOAD_BASE_URL=http://localhost:5000/files

# ── Database (Prisma / MySQL) ───────────────────────────────────────────────
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Local dev should use a non-production database.
DATABASE_URL=<SET_ME>

# ── Authentication (JWT) ────────────────────────────────────────────────────
# B10: minimum 64 chars enforced at boot. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<SET_ME>
JWT_EXPIRES_IN=7d

# ── Google OAuth ────────────────────────────────────────────────────────────
# Backend reads this to validate ID tokens issued by Google Sign-In.
# Frontend also needs VITE_GOOGLE_CLIENT_ID in web/.env
GOOGLE_CLIENT_ID=<SET_ME>

# ── MercadoPago (LATAM payments, primary) ───────────────────────────────────
# Use TEST-prefixed credentials in development.
MP_ACCESS_TOKEN=<SET_ME>
MP_PUBLIC_KEY=<SET_ME>
# Required to verify webhook signatures — must NOT be empty in production.
MP_WEBHOOK_SECRET=<SET_ME>

# ── PayPal (International payments) ─────────────────────────────────────────
# Live base URL:    https://api-m.paypal.com   (default — used when var is unset)
# Sandbox base URL: https://api-m.sandbox.paypal.com
# Leave PAYPAL_BASE_URL blank in production to inherit the live default; only
# set it explicitly when you're pointing dev at sandbox.
PAYPAL_CLIENT_ID=<SET_ME>
PAYPAL_CLIENT_SECRET=<SET_ME>
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# REQUIRED in production when PAYPAL_CLIENT_ID is set — the boot pre-flight in
# config/env.js refuses to start otherwise. Source: Developer Dashboard →
# your app → Webhooks → the webhook entry has a "Webhook ID" field.
PAYPAL_WEBHOOK_ID=<SET_ME>

# ── Email / SMTP (Hostinger) ────────────────────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
# 'true' (default) uses implicit TLS on 465; set 'false' to downgrade to
# STARTTLS on 587. Anything other than the literal 'false' is treated as true.
SMTP_SECURE=true
SMTP_USER=<SET_ME>
SMTP_PASS=<SET_ME>
MAIL_FROM_NAME=Mustapha Ukizuru
MAIL_FROM_ADDRESS=hello@mustaphaukizuru.com
# Reply-to / support inbox surfaced in email footers. Falls back to SMTP_USER.
SUPPORT_EMAIL=hello@mustaphaukizuru.com
# Domain emails fetch the brand logo from (must serve /images/profile/*).
EMAIL_LOGO_DOMAIN=https://mustaphaukizuru.com

# ── Telegram Bot (notifications) ────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=<SET_ME>

# ── B11 · Error tracking (optional) ─────────────────────────────────────────
# Get DSN from https://sentry.io · empty value disables Sentry entirely.
# Recommended in production for catching unhandled exceptions and slow routes.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── B11 · Backups (optional) ────────────────────────────────────────────────
# Override these only if your Hostinger MySQL host needs a non-default mysqldump
# binary path. The backup script auto-detects /usr/bin/mysqldump otherwise.
# MYSQLDUMP_BIN=/usr/bin/mysqldump

# SEO04 · Google Analytics 4 measurement ID. Leave empty to disable GA.
VITE_GA_MEASUREMENT_ID=

# I18N · enable English+Spanish routing. Set to false to lock the site to English.
VITE_I18N_ENABLED=true

# ── Google Calendar / Meet integration (REQUIRED in production) ─────────────
# Powers auto-creation of Google Meet links when a client books a consultation.
#
# When ANY of these is unset, bookings still succeed but the row is saved
# with meetingLink=null and meetingProvider="manual" — the admin must paste a
# link manually from /admin/consultations before the client can join.
# There is NO automatic fallback to Jitsi (removed in Phase 11 polish to keep
# the customer experience consistent on a single provider).
#
# The five env vars + their setup notes live in their own focused file:
#   config/google-meet.env.template
# And the full Cloud-Console walk-through lives at:
#   docs/google-meet-setup.md
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_CALENDAR_HOST_EMAIL=hello@mustaphaukizuru.com
GOOGLE_CALENDAR_ID=primary
# Used ONLY by scripts/google-oauth-bootstrap.js to issue the refresh token.
# Must match a redirect URI registered in the Google Cloud Console for the
# OAuth client. Does NOT need to be a real route — the bootstrap captures
# the code by manual paste, not by hosting a callback.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/api/v1/admin/google/oauth-callback

# ── Booking (optional) ──────────────────────────────────────────────────────
# Pin a specific user id as the booking host. When unset, availability falls
# back to Service.createdById, then to the alphabetically-first active admin.
# Useful when you have multiple admins and want bookings to land with a
# specific one regardless of which service the customer chose.
DEFAULT_HOST_USER_ID=

# ── Operations ──────────────────────────────────────────────────────────────
# Set DISABLE_CRON=1 on staging / preview environments to silence the
# scheduled jobs (analytics aggregation, booking reminders) so they don't
# fire on a non-production database.
DISABLE_CRON=
