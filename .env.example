# ─────────────────────────────────────────────────────────────────────────────
# MUSTAPHA UKIZURU API — Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control
# ─────────────────────────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Database (Hostinger MySQL)
DATABASE_URL=mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME

# JWT — Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GENERATE_A_STRONG_SECRET_KEY_HERE
JWT_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com


# ─────────────────────────────────────────────────────────────────────────────
# Mercado Pago (primary payment gateway)
# Get credentials at: https://www.mercadopago.com.br/developers/panel
# ─────────────────────────────────────────────────────────────────────────────
MP_ACCESS_TOKEN=APP_USR-your_access_token_here
MP_PUBLIC_KEY=APP_USR-your_public_key_here
MP_WEBHOOK_SECRET=your_webhook_secret_optional
# API public URL — needed for Mercado Pago webhook notification_url
API_URL=https://yourdomain.com

# PayPal (secondary payment gateway)
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_BASE_URL=https://api-m.paypal.com

# Email (Hostinger SMTP)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hello@yourdomain.com
SMTP_PASS=your_email_password
SUPPORT_EMAIL=hello@yourdomain.com
FRONTEND_URL=https://yourdomain.com
