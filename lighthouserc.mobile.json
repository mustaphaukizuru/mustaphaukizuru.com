{
  "_comment": "Lighthouse CI budget (mobile, simulated 4G + CPU 4x) · relaxed perf floor 0.85; other gates identical to desktop lighthouserc.json",
  "ci": {
    "collect": {
      "url": [
        "http://localhost:5097/",
        "http://localhost:5097/about",
        "http://localhost:5097/services",
        "http://localhost:5097/store",
        "http://localhost:5097/contact",
        "http://localhost:5097/privacy",
        "http://localhost:5097/terms"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "throttlingMethod": "simulate",
        "screenEmulation": {
          "mobile": true,
          "width": 412,
          "height": 823,
          "deviceScaleFactor": 1.75,
          "disabled": false
        }
      },
      "startServerCommand": "node -e \"process.env.PORT=5097;process.env.DISABLE_CRON=1;require('./src/server')\"",
      "startServerReadyPattern": "Server running on port",
      "startServerReadyTimeout": 60000
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.85
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 4000
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ],
        "interactive": [
          "error",
          {
            "maxNumericValue": 5000
          }
        ],
        "first-contentful-paint": [
          "error",
          {
            "maxNumericValue": 3000
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 600
          }
        ],
        "color-contrast": "error",
        "image-alt": "error",
        "label": "error",
        "link-name": "error",
        "meta-description": "error",
        "html-has-lang": "error",
        "viewport": "error"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
