{
  "name": "mustaphaukizuru-server",
  "version": "2.0.0",
  "description": "Mustapha Ukizuru API + static frontend server",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "postinstall": "node scripts/prisma-generate.js",
    "build": "cd web && npm run build:seo",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint:structure": "bash scripts/guard-duplicates.sh",
    "backup": "bash scripts/backup-db.sh",
    "smoke": "bash scripts/smoke-test.sh",
    "deploy": "bash scripts/deploy.sh",
    "seed:email": "node scripts/guard-prod-db.js \"seed:email\" && node prisma/seed-email-templates.js",
    "seed:client-logos": "node scripts/guard-prod-db.js \"seed client logos\" && node prisma/seed-client-logos.js",
    "seed:plans": "node scripts/guard-prod-db.js \"seed:plans\" && node prisma/seed-service-plans.js",
    "seed:bio": "node scripts/guard-prod-db.js \"seed:bio\" && node prisma/seed-bio.js",
    "seed:audience-plans": "node scripts/guard-prod-db.js \"seed:audience-plans\" && node prisma/seed-audience-plans.js",
    "janitor:orders": "node scripts/cancel-stale-orders.js",
    "optimize:images": "bash scripts/optimize-images.sh",
    "seed:products": "node scripts/guard-prod-db.js \"seed:products\" && node prisma/seed/products-seed.js",
    "seed:blog": "node scripts/guard-prod-db.js \"seed:blog\" && node prisma/seed-blog.js",
    "google:bootstrap": "node scripts/google-oauth-bootstrap.js",
    "google:verify": "node scripts/google-meet-verify.js",
    "consultations:heal-links": "node scripts/heal-consultation-links.js",
    "test:integration": "jest test/integration",
    "test:unit": "jest --testPathIgnorePatterns=test/integration",
    "db:guard": "node scripts/guard-prod-db.js",
    "db:push": "node scripts/guard-prod-db.js \"prisma db push\" && node scripts/db-push.js",
    "restore": "node scripts/guard-prod-db.js \"restore into this database\" && node scripts/restore-db-json.js",
    "seed:demo": "node scripts/guard-prod-db.js \"seed:demo\" && node prisma/seed/demo-seed.js",
    "seed:content": "node scripts/guard-prod-db.js \"seed:content\" && node prisma/seed/products-seed.js && node prisma/seed/services-seed.js && node prisma/seed/portfolio-seed.js && node prisma/seed-bio.js && node prisma/seed-client-logos.js && node prisma/seed-blog.js && node prisma/seed-service-plans.js && node prisma/seed-audience-plans.js && node prisma/seed-email-templates.js && node prisma/seed/product-images-seed.js",
    "dev:demo": "node scripts/dev-demo.js",
    "seed:product-images": "node scripts/guard-prod-db.js \"seed:product-images\" && node prisma/seed/product-images-seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^10.71.0",
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.2",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^2.30.0",
    "date-fns-tz": "^2.0.1",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.4.1",
    "google-auth-library": "^9.15.0",
    "googleapis": "^171.4.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.18.0",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "prisma": "^6.19.3",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test"
    ],
    "testMatch": [
      "**/*.test.js",
      "**/*.spec.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js",
      "!src/lib/prisma.js"
    ],
    "coverageDirectory": "<rootDir>/coverage",
    "verbose": true,
    "coverageThreshold": {
      "global": {
        "lines": 44,
        "statements": 41,
        "branches": 26,
        "functions": 27
      }
    },
    "globalSetup": "<rootDir>/test/helpers/ensureIndexHtml.js",
    "globalTeardown": "<rootDir>/test/helpers/globalTeardown.js"
  },
  "engines": {
    "node": ">=20.0.0 <23.0.0"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "deepmerge-ts": ">=8.0.0",
    "qs": "^6.16.0"
  }
}
