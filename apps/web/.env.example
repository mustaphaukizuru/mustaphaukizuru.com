# API Connection
VITE_API_BASE_URL=http://localhost:5000

# Google OAuth (public — safe in frontend)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Stripe (public key only — NEVER put secret key here)

# Mercado Pago (public key only — safe in frontend)
VITE_MP_PUBLIC_KEY=APP_USR-your_public_key_here

# PayPal (client ID only)
VITE_PAYPAL_CLIENT_ID=your_paypal_client_id

# App
VITE_APP_NAME=Mustapha Ukizuru
VITE_APP_URL=http://localhost:5173
