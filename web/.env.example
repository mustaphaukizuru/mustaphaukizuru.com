# =============================================================================
#  mustaphaukizuru.com · Frontend (Vite) environment template
#  Copy to web/.env and fill in real values. NEVER commit filled-in copies.
#
#  Vite only exposes variables prefixed with VITE_ to client-side code.
#  Never put server-side secrets (DB password, JWT secret, API secret keys)
#  here — they would be bundled into the browser build.
# =============================================================================

# ── API endpoint ────────────────────────────────────────────────────────────
# Development: http://localhost:5000
# Production:  leave empty ("") for same-origin requests served by Express
VITE_API_BASE_URL=http://localhost:5000
# API version prefix used by web/src/lib/api.js (default "/v1" → /api/v1/...).
# Leave unset to use the default; set to "" to hit the legacy unversioned paths.
VITE_API_VERSION=/v1

# ── Canonical site origin (SEO: canonical/hreflang/OG URLs, no trailing /) ──
VITE_SITE_URL=https://mustaphaukizuru.com

# ── PayPal (public client ID, safe to expose) ───────────────────────────────
VITE_PAYPAL_CLIENT_ID=<SET_ME>

# ── Motion ──────────────────────────────────────────────────────────────────
# "false" disables the Lenis smooth-scroll provider at build time
# (prefers-reduced-motion is always honoured regardless).
VITE_SMOOTH_SCROLL=true

# ── Internationalization flag (enables /es/* routing + hreflang in sitemap) ─
# Set to "true" in production after I18N prompts ship. See 05-I18N-PROMPTS.md.
VITE_I18N_ENABLED=false

# ── Sentry · browser telemetry (optional; unset = no-op) ────────────────────
# Public browser DSN from the Sentry project (safe to expose — it can only
# ingest). The API's CSP allows this host automatically when the same var is
# present in the root .env (src/lib/sentryCsp.js). See src/lib/sentry.js.
VITE_SENTRY_DSN=
# Release tag sent with every event. Unset = web/package.json version
# (injected at build as __APP_VERSION__). Set to a git SHA in CI if preferred.
# VITE_APP_VERSION=

# ── Google Analytics 4 (optional; unset = no-op, safe for dev) ──────────────
# See 04-SEO-PROMPTS.md · SEO04 for setup.
VITE_GA_MEASUREMENT_ID=

# IVA rate contained in listed prices — display only; must match TAX_RATE on the API.
VITE_TAX_RATE=0.16
