{
  "name": "web",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . && npm run lint:tokens && npm run lint:contrast && npm run lint:shadows",
    "lint:tokens": "node ./scripts/check-raw-hex.mjs",
    "lint:contrast": "node ./scripts/check-contrast.mjs",
    "lint:shadows": "node ./scripts/check-shadows.mjs",
    "test:i18n": "node ./scripts/check-i18n.mjs",
    "clean": "rm -rf ../public/assets",
    "build:clean": "npm run clean && vite build",
    "seo:sitemap": "node ./scripts/generate-sitemap.mjs",
    "catalog:generate": "node ./scripts/generate-service-catalog.mjs",
    "build:seo": "npm run build && npm run seo:sitemap",
    "seo:ping": "node ./scripts/sitemap-ping.mjs",
    "images:webp": "node ./scripts/convert-images.mjs",
    "og:build": "node ./scripts/generate-og-images.mjs",
    "test:e2e": "playwright test",
    "dev:demo": "vite --mode demo --port 5174",
    "covers:build": "node ./scripts/generate-product-covers.mjs"
  },
  "dependencies": {
    "@sentry/react": "^10.73.0",
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.1",
    "gsap": "^3.15.0",
    "i18next": "^26.4.1",
    "i18next-browser-languagedetector": "^8.0.0",
    "lenis": "^1.3.26",
    "lottie-react": "^3.1.1",
    "lucide-react": "^1.39.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^17.0.13",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.3",
    "sonner": "^2.0.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.27",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.8",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.1",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.0.1",
    "workbox-window": "^7.3.0"
  }
}
