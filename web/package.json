{
  "name": "web",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . && npm run lint:tokens && npm run lint:contrast && npm run lint:shadows && npm run lint:type",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "lint:tokens": "node ./scripts/check-raw-hex.mjs",
    "lint:contrast": "node ./scripts/check-contrast.mjs",
    "lint:shadows": "node ./scripts/check-shadows.mjs",
    "test:i18n": "node ./scripts/check-i18n.mjs",
    "clean": "rm -rf ../public/assets",
    "build:clean": "npm run clean && vite build",
    "seo:sitemap": "node ./scripts/generate-sitemap.mjs",
    "catalog:generate": "node ./scripts/generate-service-catalog.mjs",
    "build:seo": "npm run build && npm run seo:sitemap",
    "seo:ping": "node ./scripts/sitemap-ping.mjs",
    "images:webp": "node ./scripts/convert-images.mjs",
    "og:build": "node ./scripts/generate-og-images.mjs",
    "test:e2e": "playwright test",
    "dev:demo": "vite --mode demo --port 5174",
    "covers:build": "node ./scripts/generate-product-covers.mjs",
    "lint:type": "node ./scripts/check-typography.mjs"
  },
  "dependencies": {
    "@sentry/react": "^10.20.0",
    "@tailwindcss/vite": "^4.2.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.35.2",
    "gsap": "^3.15.0",
    "i18next": "^23.15.2",
    "i18next-browser-languagedetector": "^8.0.0",
    "lenis": "^1.3.23",
    "lottie-react": "^3.1.0",
    "lucide-react": "^0.577.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^15.0.3",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.13.1",
    "sonner": "^1.7.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.27",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.8",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.1",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.0.1",
    "vitest": "^3.2.7",
    "workbox-window": "^7.3.0"
  }
}
