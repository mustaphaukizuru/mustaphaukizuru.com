# =============================================================================
#  mustaphaukizuru.com · .gitignore
#  Node.js + Express + Prisma + React (Vite) full-stack monorepo.
# =============================================================================

# ── Secrets (NEVER commit) ──────────────────────────────────────────────────
.env
.env.*
!.env.example
web/.env
web/.env.*
!web/.env.example

# ── B01 cleanup backups ─────────────────────────────────────────────────────
backups/

# ── Dependencies ────────────────────────────────────────────────────────────
node_modules/
web/node_modules/
.pnp
.pnp.js

# ── Build artefacts ─────────────────────────────────────────────────────────
# Vite emits the SPA bundle into /public (web/vite.config.js outDir) and
# scripts/deploy.sh rebuilds it on the server, so the generated files are not
# tracked. Everything else under /public (images, fonts, cv, documents, flags,
# favicons, .htaccess, static error pages) is source and stays in git.
/public/assets/
/public/index.html
/public/sw.js
/public/workbox-*.js
/public/registerSW.js
/public/manifest.webmanifest
# Lighthouse CI reports — regenerated by every run, never source.
.lighthouseci/

# Build-time route snapshots (node scripts/prerender.mjs) — regenerated
# after every `vite build`, so they follow the bundle and stay untracked.
/public/__prerender/
dist/
build/
web/dist/
web/build/

# ── Logs ────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Runtime / caches ────────────────────────────────────────────────────────
.cache/
.parcel-cache/
.vite/
web/.vite/
*.tsbuildinfo
.npm/
.eslintcache

# ── Prisma ──────────────────────────────────────────────────────────────────
# Generated Prisma Client lives inside node_modules; nothing to ignore here.
# But ignore any DB dumps or migration backups accidentally created locally.
*.sql.bak
prisma/migrations/.backup/

# ── Uploads (user-generated content, never in git) ──────────────────────────
uploads/
public/uploads/
public/media/
public/avatars/

# ── OS / Editor cruft ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*~
*.swp
*.swo
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.history/

# ── Misc tooling ────────────────────────────────────────────────────────────
coverage/
.nyc_output/
*.pid
*.seed
*.pid.lock
.env.local

# Workspace document folders (Cowork sessions)
mustaphaukizuru.com*Full-Stack SaaS Platform/

# Claude Code workspace — agent worktrees, session state, local settings.
# Previously committed by accident as a submodule gitlink, which broke
# `git submodule update --recursive` (used by GitHub Pages checkout).
# Never commit this directory.
.claude/

