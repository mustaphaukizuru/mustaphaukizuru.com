{
  "_comment": "Lighthouse CI budget (desktop) · audit finding M-13 · WCV targets per PROJECT_INSTRUCTIONS § 11. Mobile variant: lighthouserc.mobile.json",
  "ci": {
    "collect": {
      "url": [
        "http://localhost:5098/",
        "http://localhost:5098/about",
        "http://localhost:5098/services",
        "http://localhost:5098/store",
        "http://localhost:5098/contact",
        "http://localhost:5098/privacy",
        "http://localhost:5098/terms"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "formFactor": "desktop",
        "throttlingMethod": "simulate"
      },
      "startServerCommand": "node -e \"process.env.PORT=5098;require('./scripts/lighthouse-server')\"",
      "startServerReadyPattern": "Server running on port",
      "startServerReadyTimeout": 60000
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "largest-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 2500
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ],
        "interactive": [
          "warn",
          {
            "maxNumericValue": 3500
          }
        ],
        "first-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 1800
          }
        ],
        "total-blocking-time": [
          "warn",
          {
            "maxNumericValue": 200
          }
        ],
        "color-contrast": "error",
        "image-alt": "error",
        "label": "error",
        "link-name": "error",
        "meta-description": "error",
        "html-has-lang": "error",
        "viewport": "error"
      },
      "_comment": "Desktop budgets are UNVERIFIED on this branch - only the mobile config was run (see lighthouserc.mobile.json). Perf and the CWV timings are WARN until someone runs `lhci autorun --config=lighthouserc.json` and sets measured numbers. a11y/best-practices/seo stay hard gates at 0.95."
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
