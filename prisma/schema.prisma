// ═══════════════════════════════════════════════════════════════════════════════
// B08 · Wishlist + Saved Addresses
// ═══════════════════════════════════════════════════════════════════════════════

/// DEPRECATED (2026-08) · feature removed from the app; no code reads or writes this table.
/// Kept so `prisma db push` does not drop production data. Drop in a dedicated,
/// backed-up migration once you have confirmed nothing else depends on it.
model Wishlist {
  id        String         @id @default(cuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

/// DEPRECATED (2026-08) · feature removed from the app; no code reads or writes this table.
/// Kept so `prisma db push` does not drop production data. Drop in a dedicated,
/// backed-up migration once you have confirmed nothing else depends on it.
model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  addedAt    DateTime @default(now())

  @@unique([wishlistId, productId])
  @@index([productId])
}

model Address {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label      String? // "Home", "Office" — short free-form label
  fullName   String
  company    String?
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String
  country    String // ISO 3166-1 alpha-2, e.g. "MX"
  taxId      String? // Mexican RFC or country-specific tax ID
  phone      String?
  isDefault  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, isDefault])
}

// ═══════════════════════════════════════════════════════════════════════════════
// B09 · Two-Factor Authentication (TOTP + backup codes)
// ═══════════════════════════════════════════════════════════════════════════════

model TwoFactorAuth {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  secret    String // base32-encoded TOTP secret
  isEnabled Boolean @default(false) // false until first verify-and-enable

  // Json array of { codeHash: string, used: boolean, usedAt: string|null }
  // Codes are bcrypt-hashed; one-time-use; replaced en bloc on regenerate.
  backupCodes Json

  /// Highest TOTP time-step already accepted for this user. RFC 6238 §5.2
  /// requires a one-time-password to be usable exactly once: without this,
  /// an observed code stays replayable for the whole verification window.
  /// Nullable so `db push` is additive; null means "nothing consumed yet".
  lastUsedStep BigInt?

  enabledAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// =============================================================
/// M12 · BIO CMS (Experience · Certificate · Skill)
/// Powers the About page sections; admin edits at /admin/bio.
/// =============================================================

model Experience {
  id           String    @id @default(cuid())
  role         String
  company      String
  companyLogo  String?
  location     String?
  startDate    DateTime
  endDate      DateTime?
  description  String    @db.Text
  highlights   Json?
  tools        Json?
  displayOrder Int       @default(0)
  isVisible    Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isVisible])
  @@index([displayOrder])
}

/// =============================================================
/// M12.5 · BIO · EDUCATION (mirrors Experience for academic history)
/// =============================================================

model Education {
  id              String    @id @default(cuid())
  degree          String
  institution     String
  institutionLogo String?
  location        String?
  startDate       DateTime
  endDate         DateTime? // null = currently studying
  description     String    @db.Text
  highlights      Json?
  fieldOfStudy    String?
  grade           String?
  displayOrder    Int       @default(0)
  isVisible       Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isVisible])
  @@index([displayOrder])
}

model Certificate {
  id            String    @id @default(cuid())
  title         String
  issuer        String
  issuerLogo    String?
  issueDate     DateTime
  expiryDate    DateTime?
  credentialId  String?
  credentialUrl String?
  pdfUrl        String?
  category      String?
  displayOrder  Int       @default(0)
  isVisible     Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([isVisible])
  @@index([category])
}

enum SkillCategory {
  frontend
  backend
  tools
  database
  cloud
  language
  soft_skill
}

model Skill {
  id           String        @id @default(cuid())
  name         String
  category     SkillCategory
  proficiency  Int // 1-5
  iconKey      String?
  yearsUsing   Int?
  displayOrder Int           @default(0)
  isVisible    Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([isVisible])
  @@index([category])
}

/// =============================================================
/// M14 · PRIVACY-FIRST ANALYTICS
/// Server-side, cookieless, no PII. Powered by hashed session IDs.
/// =============================================================

model PageView {
  id          String   @id @default(cuid())
  path        String   @db.VarChar(512)
  referrer    String?  @db.VarChar(512)
  country     String?  @db.VarChar(8)
  device      String?  @db.VarChar(16)
  uaHash      String?  @db.VarChar(64)
  sessionHash String?  @db.VarChar(64)
  createdAt   DateTime @default(now())

  @@index([path, createdAt])
  @@index([createdAt])
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(64)
  path        String?  @db.VarChar(512)
  productId   String?
  serviceId   String?
  orderId     String?
  // Bumped from Decimal(10,2) → Decimal(14,2): the previous precision
  // truncated at 99,999.99, which a six-figure MXN order would silently
  // round. Aligns with the platform-standard money precision used by
  // Order.totalAmount, Refund.amount, and the Coupon thresholds.
  amount      Decimal? @db.Decimal(14, 2)
  meta        Json?
  sessionHash String?  @db.VarChar(64)
  createdAt   DateTime @default(now())

  @@index([name, createdAt])
  @@index([createdAt])
}

model DailyMetric {
  id            String   @id @default(cuid())
  date          DateTime @db.Date
  pageviews     Int      @default(0)
  sessions      Int      @default(0)
  addToCart     Int      @default(0)
  beginCheckout Int      @default(0)
  purchases     Int      @default(0)
  revenue       Decimal  @default(0) @db.Decimal(12, 2)
  topPath       String?  @db.VarChar(512)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([date])
  @@index([date])
}

/// =============================================================
/// M16 · BLOG · BlogPost · BlogCategory · BlogTag · BlogTagMap
/// Powers the public /blog index + admin CMS at /admin/blog.
/// =============================================================

enum BlogPostStatus {
  draft
  published
  archived
}

model BlogCategory {
  id           String     @id @default(cuid())
  slug         String     @unique
  label        String
  accent       String     @default("#5D3FD3") // Brand accent color
  description  String?    @db.Text
  displayOrder Int        @default(0)
  isVisible    Boolean    @default(true)
  posts        BlogPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isVisible, displayOrder])
}

model BlogTag {
  id        String       @id @default(cuid())
  slug      String       @unique
  label     String
  posts     BlogTagMap[]
  createdAt DateTime     @default(now())

  @@index([slug])
}

model BlogTagMap {
  postId String
  tagId  String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

model BlogPost {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  excerpt     String  @db.Text
  body        Json // structured content blocks (see BlogContentRenderer)
  cover       String? @db.VarChar(512)
  readMinutes Int     @default(5)

  status      BlogPostStatus @default(draft)
  isFeatured  Boolean        @default(false)
  publishedAt DateTime?

  // SEO
  metaTitle       String?
  metaDescription String? @db.Text

  // Author — denormalised so historical posts keep their byline if the
  // user is later anonymised. The optional userId fk preserves the link.
  authorUserId String?
  authorName   String  @default("Mustapha Ukizuru")
  authorRole   String  @default("IT Manager · Full-Stack Developer · CS Educator")
  authorAvatar String?

  // Category — required, fkeyed
  categoryId String
  category   BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  tags BlogTagMap[]

  /// Step 42 · soft delete. Non-null = hidden from every public read.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([isFeatured, publishedAt])
  @@index([categoryId])
  @@index([deletedAt])
}

/// =============================================================
/// M19 · MARKETING · EmailCampaign · EmailCampaignRecipient
/// Broadcast / newsletter / launch announcement emails. Distinct
/// from EmailTemplate (transactional, single-event) — campaigns
/// are authored ad-hoc and sent to a snapshot audience.
/// =============================================================

enum EmailCampaignStatus {
  draft
  scheduled
  sending
  sent
  cancelled
  failed
}

enum EmailCampaignAudience {
  newsletter // every NewsletterSubscriber whose status = "subscribed"
  members // every User row
  custom // explicit list of email addresses (recipientEmails JSON)
}

model EmailCampaign {
  id        String  @id @default(cuid())
  name      String // internal label, never shown to recipients
  subject   String
  preheader String? @db.VarChar(255)
  fromName  String  @default("Mustapha Ukizuru")
  fromEmail String  @default("hello@mustaphaukizuru.com")
  replyTo   String?
  body      Json // structured content blocks (BlogContentRenderer schema)

  status          EmailCampaignStatus   @default(draft)
  audience        EmailCampaignAudience @default(newsletter)
  recipientEmails Json? // used when audience = "custom"

  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  // Aggregate counters — kept on the parent for fast dashboard reads
  totalRecipients Int @default(0)
  sentCount       Int @default(0)
  failedCount     Int @default(0)
  openCount       Int @default(0)
  clickCount      Int @default(0)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  recipients EmailCampaignRecipient[]

  @@index([status, scheduledAt])
  @@index([createdAt])
}

model EmailCampaignRecipient {
  id           String        @id @default(cuid())
  campaignId   String
  campaign     EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  email        String
  userId       String?
  status       CampaignRecipientStatus @default(queued)
  providerId   String?
  errorMessage String?       @db.Text
  sentAt       DateTime?
  openedAt     DateTime?
  clickedAt    DateTime?
  createdAt    DateTime      @default(now())

  @@unique([campaignId, email])
  @@index([campaignId, status])
  @@index([email])
}
