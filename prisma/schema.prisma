// ═══════════════════════════════════════════════════════════════════════════════
// B08 · Saved Addresses (Wishlist models dropped in T3 — feature was removed)
// ═══════════════════════════════════════════════════════════════════════════════

model Address {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label      String? // "Home", "Office" — short free-form label
  fullName   String
  company    String?
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String
  country    String // ISO 3166-1 alpha-2, e.g. "MX"
  taxId      String? // Mexican RFC (validated when country = MX) or country-specific tax ID
  /// CFDI 4.0 receiver data (MX only; see src/lib/fiscal.js for catalogs).
  legalName        String?  // razón social exactly as on the Constancia (uppercase)
  regimenFiscal    String?  @db.VarChar(3)
  usoCfdi          String?  @db.VarChar(4)
  fiscalPostalCode String?  @db.VarChar(12) // domicilio fiscal CP when it differs from postalCode
  phone      String?
  isDefault  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, isDefault])
}

// ═══════════════════════════════════════════════════════════════════════════════
// B09 · Two-Factor Authentication (TOTP + backup codes)
// ═══════════════════════════════════════════════════════════════════════════════

model TwoFactorAuth {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  secret    String // base32-encoded TOTP secret
  isEnabled Boolean @default(false) // false until first verify-and-enable

  // Json array of { codeHash: string, used: boolean, usedAt: string|null }
  // Codes are bcrypt-hashed; one-time-use; replaced en bloc on regenerate.
  backupCodes Json

  /// Highest TOTP time-step already accepted for this user. RFC 6238 §5.2
  /// requires a one-time-password to be usable exactly once: without this,
  /// an observed code stays replayable for the whole verification window.
  /// Nullable so `db push` is additive; null means "nothing consumed yet".
  lastUsedStep BigInt?

  enabledAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/// =============================================================
/// M12 · BIO CMS (Experience · Certificate · Skill)
/// Powers the About page sections; admin edits at /admin/bio.
/// =============================================================

model Experience {
  id           String    @id @default(cuid())
  role         String
  company      String
  companyLogo  String?
  location     String?
  startDate    DateTime
  endDate      DateTime?
  description  String    @db.Text
  highlights   Json?
  tools        Json?
  displayOrder Int       @default(0)
  isVisible    Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isVisible])
  @@index([displayOrder])
}

/// =============================================================
/// M12.5 · BIO · EDUCATION (mirrors Experience for academic history)
/// =============================================================

model Education {
  id              String    @id @default(cuid())
  degree          String
  institution     String
  institutionLogo String?
  location        String?
  startDate       DateTime
  endDate         DateTime? // null = currently studying
  description     String    @db.Text
  highlights      Json?
  fieldOfStudy    String?
  grade           String?
  displayOrder    Int       @default(0)
  isVisible       Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isVisible])
  @@index([displayOrder])
}

model Certificate {
  id            String    @id @default(cuid())
  title         String
  issuer        String
  issuerLogo    String?
  issueDate     DateTime
  expiryDate    DateTime?
  credentialId  String?
  credentialUrl String?
  pdfUrl        String?
  category      String?
  displayOrder  Int       @default(0)
  isVisible     Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([isVisible])
  @@index([category])
}

enum SkillCategory {
  frontend
  backend
  tools
  database
  cloud
  language
  soft_skill
}

model Skill {
  id           String        @id @default(cuid())
  name         String
  category     SkillCategory
  proficiency  Int // 1-5
  iconKey      String?
  yearsUsing   Int?
  displayOrder Int           @default(0)
  isVisible    Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([isVisible])
  @@index([category])
}

/// =============================================================
/// M14 · PRIVACY-FIRST ANALYTICS
/// Server-side, cookieless, no PII. Powered by hashed session IDs.
/// =============================================================

model PageView {
  id          String   @id @default(cuid())
  path        String   @db.VarChar(512)
  referrer    String?  @db.VarChar(512)
  country     String?  @db.VarChar(8)
  device      String?  @db.VarChar(16)
  uaHash      String?  @db.VarChar(64)
  sessionHash String?  @db.VarChar(64)
  createdAt   DateTime @default(now())

  @@index([path, createdAt])
  @@index([createdAt])
}

model AnalyticsEvent {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(64)
  path        String?  @db.VarChar(512)
  productId   String?
  serviceId   String?
  orderId     String?
  // Bumped from Decimal(10,2) → Decimal(14,2): the previous precision
  // truncated at 99,999.99, which a six-figure MXN order would silently
  // round. Aligns with the platform-standard money precision used by
  // Order.totalAmount, Refund.amount, and the Coupon thresholds.
  amount      Decimal? @db.Decimal(14, 2)
  meta        Json?
  sessionHash String?  @db.VarChar(64)
  createdAt   DateTime @default(now())

  @@index([name, createdAt])
  @@index([createdAt])
}

model DailyMetric {
  id            String   @id @default(cuid())
  date          DateTime @db.Date
  pageviews     Int      @default(0)
  sessions      Int      @default(0)
  addToCart     Int      @default(0)
  beginCheckout Int      @default(0)
  purchases     Int      @default(0)
  revenue       Decimal  @default(0) @db.Decimal(12, 2)
  topPath       String?  @db.VarChar(512)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([date])
  @@index([date])
}

/// T3-5 · addresses that must never be mailed again.
///
/// Separate from NewsletterSubscriber.status because the two answer different
/// questions. A subscriber row says "this person asked for the newsletter and
/// then stopped"; a suppression says "do not send to this address AT ALL,
/// whatever list it appears on". A hard bounce, a spam complaint and a
/// one-click unsubscribe all produce the second, and none of them should
/// depend on a row existing in a list the address may never have been on.
///
/// Filtered by countAudience and forEachAudiencePage, so a suppressed address
/// is not merely skipped at send time — it is not counted in the preview
/// either, and the operator sees the audience they will actually reach.
model SuppressionList {
  id        String   @id @default(cuid())
  /// Lower-cased. The unique index is the enforcement.
  email     String   @unique @db.VarChar(255)
  /// "unsubscribe" | "bounce" | "complaint" | "manual"
  reason    String   @db.VarChar(32)
  /// Free text: the bounce message, the campaign it came from.
  detail    String?  @db.VarChar(500)
  createdAt DateTime @default(now())

  @@index([reason])
}

/// T3-6 · real-user Web Vitals, rolled up.
///
/// Lighthouse is a lab estimate on one simulated machine. This is what
/// visitors actually experienced, at p75 — the percentile Core Web Vitals is
/// defined on, and the reason a mean is useless here: the whole point is the
/// slow quarter of visits, and an average hides them behind the fast ones.
///
/// One row per (day, route, metric). Route rather than URL: /store/:slug is
/// one performance story, and a row per product would be noise nobody can
/// act on. The raw AnalyticsEvent rows stay for as long as they stay; this
/// is what the admin page reads.
model DailyVital {
  id      String   @id @default(cuid())
  date    DateTime @db.Date
  /// The ROUTE PATTERN, not the URL. "/store/:slug", never "/store/red-hat".
  path    String   @db.VarChar(255)
  /// "LCP" | "CLS" | "INP" — the three Core Web Vitals.
  metric  String   @db.VarChar(16)
  /// Milliseconds for LCP and INP; a unitless ratio for CLS. Decimal because
  /// CLS lives in the third decimal place and an Int would round every
  /// meaningful value to 0.
  p75     Decimal  @db.Decimal(10, 4)
  /// How many measurements the p75 was taken over. A p75 of three samples is
  /// not a number to act on, and the admin table says so rather than
  /// pretending otherwise.
  samples Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, path, metric])
  @@index([date])
  @@index([metric, date])
}

/// =============================================================
/// M16 · BLOG · BlogPost · BlogCategory · BlogTag · BlogTagMap
/// Powers the public /blog index + admin CMS at /admin/blog.
/// =============================================================

enum BlogPostStatus {
  draft
  published
  archived
}

model BlogCategory {
  id           String     @id @default(cuid())
  slug         String     @unique
  label        String
  accent       String     @default("#5D3FD3") // Brand accent color
  description  String?    @db.Text
  displayOrder Int        @default(0)
  isVisible    Boolean    @default(true)
  posts        BlogPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isVisible, displayOrder])
}

model BlogTag {
  id        String       @id @default(cuid())
  slug      String       @unique
  label     String
  posts     BlogTagMap[]
  createdAt DateTime     @default(now())

  @@index([slug])
}

model BlogTagMap {
  postId String
  tagId  String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

model BlogPost {
  id          String  @id @default(cuid())
  slug        String  @unique
  title       String
  excerpt     String  @db.Text
  body        Json // structured content blocks (see BlogContentRenderer)
  cover       String? @db.VarChar(512)
  readMinutes Int     @default(5)

  status      BlogPostStatus @default(draft)
  isFeatured  Boolean        @default(false)
  publishedAt DateTime?

  // SEO
  metaTitle       String?
  metaDescription String? @db.Text

  // I18N06 · Spanish overlay (null = fall back to English). Same convention
  // as Product / Service / Portfolio: `<field>Es` is swapped in by
  // utils/pickLocale when the request locale is "es".
  titleEs           String?
  excerptEs         String? @db.Text
  bodyEs            Json?
  metaTitleEs       String?
  metaDescriptionEs String? @db.Text

  // Author — denormalised so historical posts keep their byline if the
  // user is later anonymised. The optional userId fk preserves the link.
  authorUserId String?
  authorName   String  @default("Mustapha Ukizuru")
  authorRole   String  @default("IT Manager · Full-Stack Developer · CS Educator")
  authorAvatar String?

  // Category — required, fkeyed
  categoryId String
  category   BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  tags BlogTagMap[]

  /// Step 42 · soft delete. Non-null = hidden from every public read.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([isFeatured, publishedAt])
  @@index([categoryId])
  @@index([deletedAt])
}

/// =============================================================
/// M19 · MARKETING · EmailCampaign · EmailCampaignRecipient
/// Broadcast / newsletter / launch announcement emails. Distinct
/// from EmailTemplate (transactional, single-event) — campaigns
/// are authored ad-hoc and sent to a snapshot audience.
/// =============================================================

enum EmailCampaignStatus {
  draft
  scheduled
  sending
  sent
  cancelled
  failed
}

enum EmailCampaignAudience {
  newsletter // every NewsletterSubscriber whose status = "subscribed"
  members // every User row
  custom // explicit list of email addresses (recipientEmails JSON)
}

model EmailCampaign {
  id        String  @id @default(cuid())
  name      String // internal label, never shown to recipients
  subject   String
  preheader String? @db.VarChar(255)
  fromName  String  @default("Mustapha Ukizuru")
  fromEmail String  @default("hello@mustaphaukizuru.com")
  replyTo   String?
  body      Json // structured content blocks (BlogContentRenderer schema)

  status          EmailCampaignStatus   @default(draft)
  audience        EmailCampaignAudience @default(newsletter)
  recipientEmails Json? // used when audience = "custom"

  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  // Aggregate counters — kept on the parent for fast dashboard reads
  totalRecipients Int @default(0)
  sentCount       Int @default(0)
  failedCount     Int @default(0)
  openCount       Int @default(0)
  clickCount      Int @default(0)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  recipients EmailCampaignRecipient[]

  @@index([status, scheduledAt])
  @@index([createdAt])
}

model EmailCampaignRecipient {
  id           String        @id @default(cuid())
  campaignId   String
  campaign     EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  email        String
  userId       String?
  status       CampaignRecipientStatus @default(queued)
  providerId   String?
  errorMessage String?       @db.Text
  sentAt       DateTime?
  openedAt     DateTime?
  clickedAt    DateTime?
  createdAt    DateTime      @default(now())

  @@unique([campaignId, email])
  @@index([campaignId, status])
  @@index([email])
}

/// Tier 4 · click-wrap acceptance record (NDA today; `type` leaves room for
/// SOW / DPA later). One row per (project, user, type, version) so a version
/// bump on the project asks the client again while keeping the old record.
model ProjectAgreement {
  id         String   @id @default(cuid())
  projectId  String
  userId     String
  type       String   @db.VarChar(16)
  version    String   @db.VarChar(16)
  acceptedAt DateTime @default(now())
  ipAddress  String?
  userAgent  String?  @db.VarChar(512)

  project ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId, type, version])
  @@index([userId])
}

/// =============================================================
/// TIER 4 · BILLING SAFEGUARDS
/// =============================================================

/// Client-initiated extra work on a project (src/services/changeRequestService.js).
/// requested → quoted (admin) → accepted (client; creates the payable Order +
/// ServiceOrder + a milestone) → done, or declined. requestedById / orderId /
/// milestoneId are plain ids: their owning models are not touched by this
/// tier, so there are no back-relations — resolve them via prisma.user /
/// prisma.order / prisma.projectMilestone when needed.
/// Client logo wall on /about (components/ui/LogoCloud).
///
/// Lives in the database rather than a data file so the owner can add,
/// reorder and retire client marks from the admin without a deploy.
model ClientLogo {
  id      String @id @default(cuid())
  name    String                        // trading name — becomes the alt text
  slug    String @unique                // stable key, also the asset base name
  logoUrl String @db.VarChar(512)       // /images/... served from public/

  /// Short context line ("K-12 school · Mexico"), shown in the tooltip.
  sector   String? @db.VarChar(160)
  sectorEs String? @db.VarChar(160)
  /// Optional outbound link. Rendered as a link only when set.
  websiteUrl String? @db.VarChar(512)

  /// Optical tuning. Logos differ wildly in aspect ratio, so a single CSS
  /// height makes square badges look small next to wide wordmarks. This
  /// multiplies the base height (1.00 = default) and is adjustable per logo
  /// from the admin, which is the only practical way to get a row of mixed
  /// marks to read as the same visual weight.
  scale Decimal @default(1.00) @db.Decimal(4, 2)
  /// The mark ships with its own background (e.g. a dark tile), so it is
  /// rounded rather than blended into the cell.
  boxed Boolean @default(false)

  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model ChangeRequest {
  id            String    @id @default(cuid())
  projectId     String
  requestedById String
  title         String
  description   String    @db.Text
  /// requested | quoted | accepted | declined | done
  status        String    @default("requested") @db.VarChar(16)
  quoteAmount   Decimal?  @db.Decimal(12, 2)
  quoteCurrency String    @default("MXN")
  quoteNote     String?   @db.Text
  quotedAt      DateTime?
  acceptedAt    DateTime?
  declinedAt    DateTime?
  orderId       String?
  milestoneId   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([requestedById])
  @@index([orderId])
  @@index([status])
}
