  adminUser User @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([createdAt])
}

model Portfolio {
  id               String          @id @default(cuid())
  title            String
  slug             String          @unique
  role             String
  client           String?
  category         String
  coverImage       String?
  gallery          Json?
  shortDescription String          @db.Text
  description      String?         @db.Text
  challenge        String?         @db.Text
  solution         String?         @db.Text
  results          Json?
  tools            Json?
  tags             Json?
  liveUrl          String?
  repoUrl          String?
  year             Int?
  duration         String?
  status           PortfolioStatus @default(published)
  isFeatured       Boolean         @default(false)
  displayOrder     Int             @default(0)
  metaTitle        String?
  metaDescription  String?         @db.Text
  createdById      String?
