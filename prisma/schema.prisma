/// =============================================================
/// PRODUCTS
/// =============================================================

model ProductCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?  @db.Text
  icon        String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Product {
  id                 String        @id @default(cuid())
  categoryId         String?
  title              String
  slug               String        @unique
  shortDescription   String?       @db.Text
  description        String?       @db.Text
  fullDescription    String?       @db.Text
  price              Decimal       @db.Decimal(12, 2)
  currency           String        @default("MXN")
  /// IVA / SAT classification (src/lib/fiscal.js SAT_DEFAULTS when null).
  taxExempt          Boolean       @default(false)
  satProductCode     String?       @db.VarChar(8)  // c_ClaveProdServ
  satUnitCode        String?       @db.VarChar(3)  // c_ClaveUnidad, e.g. E48
  productType        String        @default("downloadable")
  status             ProductStatus @default(draft)
  sku                String?       @unique
  category           String?
  isActive           Boolean       @default(true)
  isFeatured         Boolean       @default(false)
  isNew              Boolean       @default(false)
  downloadUrl        String?
  fileName           String?
  /// fileSize stored as Int (supports files up to 2GB)
  fileSize           Int?
  fileType           String?
  version            String?
  /// Etsy-style key/value highlights, e.g. [{"key":"Page size","value":"8.5x11"}]
  titleEs            String?
  shortDescriptionEs String?       @db.Text
  descriptionEs      String?       @db.Text
  fullDescriptionEs  String?       @db.Text
  metaTitleEs        String?
  metaDescriptionEs  String?       @db.Text
  specifications     Json?
  /// Product FAQs as JSON: [{"question":"...","answer":"..."}, ...]
  productFaqs        Json?
  metaTitle          String?
  metaDescription    String?       @db.Text
  publishedAt        DateTime?
  createdById        String?
  rating             Float         @default(0)
  reviewCount        Int           @default(0)
  /// Step 42 · soft delete. Non-null = hidden from every public read.
  deletedAt          DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  categoryRef     ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy       User?            @relation("CreatedProducts", fields: [createdById], references: [id], onDelete: SetNull)
  images          ProductImage[]
  files           ProductFile[]
  licenses        ProductLicense[]
  features        ProductFeature[]
  orderItems      OrderItem[]
  downloadLogs    DownloadLog[]
  userDownloads   UserDownload[]
  reviews         Review[]
  recommendations Recommendation[]
  cartItems       CartItem[]

  @@index([categoryId])
  @@index([createdById])
  @@index([status])
  @@index([isActive])
  @@index([isFeatured])
  @@index([deletedAt])
}

/// T3 · Tiered licensing. One row per (product, tier); the buyer picks a
/// tier in the BuyBox and the cart/order snapshot the tier's price.
model ProductLicense {
  id        String   @id @default(cuid())
  productId String
  tier      String   @db.VarChar(16) // personal | commercial | enterprise
  name      String
  price     Decimal  @db.Decimal(12, 2)
  currency  String   @default("MXN")
  seats     Int?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, tier])
  @@index([productId])
}

model ProductFeature {
  id          String @id @default(cuid())
  productId   String
  featureText String @db.Text
  sortOrder   Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductFile {
  id                  String   @id @default(cuid())
  productId           String
  fileName            String
  filePath            String
  fileType            String?
  /// fileSize in bytes as Int
  fileSize            Int?
  version             String?
  isPrimary           Boolean  @default(false)
  maxDownloadsPerUser Int?
  uploadedAt          DateTime @default(now())

  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  downloadLogs DownloadLog[]

  @@index([productId])
}

model ProductImage {
  id        String           @id @default(cuid())
  productId String
  url       String
  altText   String?
  imageRole ProductImageRole @default(cover)
  isPrimary Boolean          @default(false)
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

/// =============================================================
/// REVIEW — unified model for product AND service reviews.
/// Backed by the legacy `product_reviews` table via @@map; existing rows
/// keep their ids and content. New nullable columns (status, serviceId,
/// adminReply, etc.) are populated lazily as reviews are interacted with.
/// =============================================================
enum ReviewStatus {
  pending // awaiting moderation
  approved // visible publicly
  hidden // admin took it down (still in DB for audit)
  flagged // auto-mod or community flagged for human review
  rejected // admin explicitly rejected; soft-deleted
}

model Review {
  id                 String       @id @default(cuid())
  /// Discriminator — "product" or "service". Lets us treat reviews
  /// uniformly without polymorphic FK juggling.
  subjectType        String       @default("product") @db.VarChar(16)
  productId          String?
  serviceId          String?
  /// The OrderItem that produced this review (anti-fake-review pin).
  /// Required for verified-purchase reviews; null for legacy / unverified.
  orderItemId        String?
  /// Tier 4 · review collected from a completed ClientProject (portal form).
  projectId          String?
  userId             String
  rating             Int
  /// T5-21 · the one-question pulse above the review form: "how did this
  /// go", 1 to 5.
  ///
  /// Separate from `rating`, which is the PUBLIC star rating on a service.
  /// This one is never published — it is asked before the review, answers a
  /// different question ("how was working with us" rather than "how good is
  /// this service"), and a client who abandons the form after answering it
  /// has still told us the thing worth knowing.
  pulse              Int?
  reviewText         String?      @db.Text
  isVerifiedPurchase Boolean      @default(false)
  status             ReviewStatus @default(pending)
  flaggedReason      String?      @db.VarChar(120)

  /// Admin reply — public, displayed under the review on the product/service page.
  adminReply     String?   @db.Text
  adminReplyAt   DateTime?
  adminReplyById String?

  /// Engagement signals (Sprint 1 wires storage; UI lands in Sprint 2)
  helpfulCount Int @default(0)

  /// Curation (Sprint 3 surfaces these on Home/Services)
  featured      Boolean @default(false)
  featuredOrder Int?

  /// Trust transparency
  editedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product      Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)
  service      Service?     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  user         User         @relation("AuthoredReviews", fields: [userId], references: [id], onDelete: Cascade)
  adminReplyBy User?        @relation("AdminReviewReplies", fields: [adminReplyById], references: [id], onDelete: SetNull)
  orderItem    OrderItem?   @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  project      ClientProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  votes        ReviewVote[]

  @@index([productId])
  @@index([serviceId])
  @@index([projectId])
  @@index([userId])
  @@index([status])
  @@index([featured])
  // Hot path · public product page renders approved reviews newest-first.
  // The single-column [status] + [productId] indexes can't service the
  // ORDER BY createdAt DESC efficiently — this compound covers it.
  @@index([productId, status, createdAt])
  @@map("product_reviews")
}

/// =============================================================
/// REVIEW VOTE — "Was this helpful?" tally with one vote per user.
/// =============================================================
model ReviewVote {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  helpful   Boolean  @default(true)
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([reviewId])
  @@index([userId])
}

/// =============================================================
/// RECOMMENDATION — admin-curated picks (tools, books, partners,
/// templates, services). Surfaces on /recommendations and contextually
/// next to related products / services.
/// =============================================================
enum RecommendationStatus {
  draft
  published
  archived
}

/// DEPRECATED (2026-08) · feature removed from the app; no code reads or writes this table.
/// Kept so `prisma db push` does not drop production data. Drop in a dedicated,
/// backed-up migration once you have confirmed nothing else depends on it.
model Recommendation {
  id       String  @id @default(cuid())
  title    String
  slug     String  @unique
  summary  String  @db.Text
  body     String? @db.Text // markdown
  imageUrl String? @db.VarChar(512)
  category String  @default("tool") @db.VarChar(48)
  /// tool | book | course | template | service | partner

  priority Int                  @default(0) // sort, higher = earlier
  status   RecommendationStatus @default(draft)

  /// Optional internal links — at most one of these should be set.
  productId   String?
  serviceId   String?
  externalUrl String? @db.VarChar(512)

  /// Disclosure flag — surfaces "(affiliate)" on the public card.
  isAffiliate Boolean @default(false)

  /// SEO
  metaTitle       String? @db.VarChar(180)
  metaDescription String? @db.Text

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("CreatedRecommendations", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([category])
  @@index([priority])
  @@index([productId])
  @@index([serviceId])
}

/// =============================================================
/// SERVICES
/// =============================================================

model Service {
  id               String        @id @default(cuid())
  title            String
  slug             String        @unique
  shortDescription String        @db.Text
  fullDescription  String?       @db.Text
  basePrice        Decimal       @default(0.00) @db.Decimal(12, 2)
  currency         String        @default("MXN")
  /// IVA / SAT classification (src/lib/fiscal.js SAT_DEFAULTS when null).
  taxExempt        Boolean       @default(false)
  satProductCode   String?       @db.VarChar(8)
  satUnitCode      String?       @db.VarChar(3)
  deliveryType     String
  status           ServiceStatus @default(draft)
  isFeatured       Boolean       @default(false)
  metaTitle        String?
  metaDescription  String?       @db.Text
  createdById      String?
  /// Step 42 · soft delete. Non-null = hidden from every public read.
  deletedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  /// Audience grouping for the public Choose-Your-Plan matrix.
  /// "professional" | "business" | "schools" — null for non-audience services.
  audienceCode String? @db.VarChar(32)

  /// =========================================================
  /// BOOKING POLICY — controls public consultation booking
  /// =========================================================
  /// When isBookable=true, the public booking calendar exposes this service.
  /// All time fields are interpreted in the host's timezone (per AvailabilityRule).
  isBookable             Boolean @default(false)
  bookingDurationMin     Int     @default(30)
  bookingBufferMin       Int     @default(15)
  bookingMinNoticeHours  Int     @default(24)
  bookingMaxAdvanceDays  Int     @default(60)
  bookingRequiresPayment Boolean @default(false)
  /// Booking Hardening v1 · per-service cancel/reschedule notice windows.
  /// Replace the previous hardcoded 12h gate in consultationService.
  /// Members cannot cancel within `bookingCancellationNoticeHours` of start,
  /// nor reschedule within `bookingRescheduleNoticeHours`. Admins bypass.
  bookingCancellationNoticeHours Int @default(12)
  bookingRescheduleNoticeHours   Int @default(12)

  createdBy          User?              @relation("CreatedServices", fields: [createdById], references: [id], onDelete: SetNull)
  features           ServiceFeature[]
  packages           ServicePackage[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  serviceOrders      ServiceOrder[]
  availabilityRules  AvailabilityRule[]
  consultations      Consultation[]
  reviews            Review[]
  recommendations    Recommendation[]
  titleEs            String?
  shortDescriptionEs String?            @db.Text
  descriptionEs      String?            @db.Text
  metaTitleEs        String?
  metaDescriptionEs  String?            @db.Text

  @@index([createdById])
  @@index([status])
  @@index([isBookable])
  @@index([audienceCode])
  @@index([deletedAt])
}

model ServiceFeature {
  id          String @id @default(cuid())
  serviceId   String
  featureText String @db.Text
  sortOrder   Int    @default(0)

  service Service              @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  slots   PackageFeatureSlot[]

  @@index([serviceId])
}

model ServicePackage {
  id          String   @id @default(cuid())
  serviceId   String
  name        String
  description String?  @db.Text
  price       Decimal  @db.Decimal(12, 2)
  currency    String   @default("MXN")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  /// Tier metadata for the public Choose-Your-Plan matrix.
  /// tierKey: "basic" | "medium" | "advanced"
  /// period:  "month" | "one-time" — display label only
  /// popular: shows the "Most Popular" badge
  /// saveLabel: small chip e.g. "Save 20%" / "All-inclusive"
  tierKey   String? @db.VarChar(32)
  period    String? @db.VarChar(32)
  popular   Boolean @default(false)
  saveLabel String? @db.VarChar(64)

  service       Service              @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceOrders ServiceOrder[]
  featureSlots  PackageFeatureSlot[]
  nameEs        String?
  descriptionEs String?              @db.Text

  @@index([serviceId])
  @@index([tierKey])
}

/// Join row mapping which Service Features are included in a given Package.
/// Drives the ✓/✗ matrix shown on the public Choose-Your-Plan page.
/// DEPRECATED (2026-08) · feature removed from the app; no code reads or writes this table.
/// Kept so `prisma db push` does not drop production data. Drop in a dedicated,
/// backed-up migration once you have confirmed nothing else depends on it.
model PackageFeatureSlot {
  id        String @id @default(cuid())
  packageId String
  featureId String

  package ServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  feature ServiceFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([packageId, featureId])
  @@index([packageId])
  @@index([featureId])
}

/// =============================================================
/// CART, ORDERS, PAYMENTS
/// =============================================================

model Cart {
  id              String     @id @default(cuid())
  userId          String?
  sessionToken    String?
  status          CartStatus @default(active)
  appliedCouponId String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user          User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         CartItem[]
  appliedCoupon Coupon?    @relation("CartAppliedCoupon", fields: [appliedCouponId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([sessionToken])
  @@index([appliedCouponId])
}

model CartItem {
  id            String   @id @default(cuid())
  cartId        String
  itemType      ItemType
  productId     String?
  serviceId     String?
  titleSnapshot String
  priceSnapshot Decimal  @db.Decimal(12, 2)
  licenseTier   String?  @db.VarChar(16) // T3 · chosen ProductLicense.tier
  quantity      Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cart    Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@index([productId])
  @@index([serviceId])
}

model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique
  description   String?      @db.Text
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(12, 2)

  // Global caps
  usageLimit Int?
  usedCount  Int  @default(0)

  // B03 additions — per-user + minimum-order + stackable
  minOrderAmount Decimal? @db.Decimal(12, 2)
  maxUsesPerUser Int?
  stackable      Boolean  @default(true)

  // Validity window
  startsAt  DateTime?
  expiresAt DateTime?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  orders       Order[]
  usages       CouponUsage[]
  appliedCarts Cart[]        @relation("CartAppliedCoupon")
}

model CouponUsage {
  id       String   @id @default(cuid())
  couponId String
  userId   String
  orderId  String?
  usedAt   DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([userId])
  @@index([orderId])
}

model Order {
  id                      String      @id @default(cuid())
  orderNumber             String      @unique
  // Idempotency: a client-generated key sent as the Idempotency-Key header
  // on POST /orders. A retried or double-submitted checkout (flaky mobile
  // connection, double tap, browser retry on a lost response) reuses the
  // same key and gets the SAME order back instead of creating a second one.
  // Scoped per user in the @@unique below so two customers can never collide
  // and one customer cannot replay another's order. Nullable: legacy and
  // API-only clients that send no key keep today's behaviour.
  idempotencyKey          String?
  userId                  String?
  customerName            String
  customerEmail           String
  billingName             String?
  billingEmail            String?
  billingPhone            String?
  billingCountry          String?
  billingCity             String?
  billingStateRegion      String?
  billingPostalCode       String?
  /// Fiscal snapshot at purchase time — CFDI 4.0 "Receptor" data. Copied
  /// from the checkout form / saved Address so a later edit to the address
  /// never rewrites what an issued invoice must say. See src/lib/fiscal.js.
  billingCompany          String?
  billingTaxId            String?     @db.VarChar(40)   // RFC (MX) or foreign tax id
  billingLegalName        String?     // razón social, uppercase per Constancia
  billingRegimenFiscal    String?     @db.VarChar(3)    // SAT c_RegimenFiscal, e.g. 612
  billingUsoCfdi          String?     @db.VarChar(4)    // SAT c_UsoCFDI, e.g. G03
  billingFiscalPostalCode String?     @db.VarChar(12)   // DomicilioFiscalReceptor
  status                  OrderStatus @default(pending)
  subtotalAmount          Decimal     @default(0.00) @db.Decimal(12, 2)
  discountAmount          Decimal     @default(0.00) @db.Decimal(12, 2)
  serviceFeeAmount        Decimal     @default(0.00) @db.Decimal(12, 2)
  /// IVA snapshot (src/lib/tax.js). Prices are tax-INCLUSIVE: taxAmount is
  /// the IVA contained in totalAmount, not added on top. taxIncluded records
  /// that policy per order so history survives a future pricing change.
  taxRate                 Decimal     @default(0.0000) @db.Decimal(5, 4)
  taxAmount               Decimal     @default(0.00) @db.Decimal(12, 2)
  taxIncluded             Boolean     @default(true)
  totalAmount             Decimal     @db.Decimal(12, 2)
  currency                String      @default("MXN")
  couponId                String?
  termsAcceptedAt         DateTime?
  mercadoPagoPreferenceId String?
  paidAt                  DateTime?
  notes                   String?     @db.Text
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  coupon         Coupon?         @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  invoices       Invoice[]
  payments       Payment[]
  refunds        Refund[]
  downloadLogs   DownloadLog[]
  userDownloads  UserDownload[]
  couponUsages   CouponUsage[]
  serviceOrders  ServiceOrder[]
  /// M16 — refund-request tickets opened by the customer reference back here.
  supportTickets SupportTicket[]

  @@index([userId])
  @@index([couponId])
  @@index([status])
  @@index([createdAt])
  @@index([userId, status]) // compound: member dashboard filter by user+status
  @@index([status, createdAt]) // compound: admin order list sorted by date+status
  // Idempotency backstop. The service checks for an existing key inside the
  // transaction, but under REPEATABLE READ two concurrent submits can both see
  // "no row" and both insert — this constraint makes the second one fail with
  // P2002 instead of creating a duplicate order. Same pattern as
  // Payment.payment_gateway_tx_uq, which closes the equivalent race one step
  // later in the money path.
  @@unique([userId, idempotencyKey], name: "order_user_idempotency_uq")
}

model OrderItem {
  id                  String   @id @default(cuid())
  orderId             String
  itemType            ItemType @default(product)
  productId           String?
  serviceId           String?
  title               String
  titleSnapshot       String?
  descriptionSnapshot String?  @db.Text
  price               Decimal? @db.Decimal(12, 2)
  unitPrice           Decimal? @db.Decimal(12, 2)
  quantity            Int
  lineTotal           Decimal? @db.Decimal(12, 2)
  /// T3 · licensing snapshot: tier bought + key minted at order creation
  licenseTier         String?  @db.VarChar(16)
  licenseKey          String?  @db.VarChar(64)
  createdAt           DateTime @default(now())

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  service       Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  userDownloads UserDownload[]
  serviceOrders ServiceOrder[]
  reviews       Review[]

  @@index([orderId])
  @@index([productId])
  @@index([serviceId])
  @@index([orderId, productId]) // compound: entitlement lookup
}

model Invoice {
  id            String   @id @default(cuid())
  orderId       String
  invoiceNumber String   @unique
  invoicePdfUrl String?
  /// Tier 4 billing. Storefront invoices are born `paid` (they are only
  /// generated after payment). Admin-issued manual invoices start `issued`,
  /// move to `overdue` by src/jobs/invoiceDunningJob.js once past dueDate,
  /// and to `paid` when the pending Order is paid. `void` is admin-only.
  /// Values: issued | paid | overdue | void.
  status            String   @default("issued") @db.VarChar(16)
  /// Manual invoices are raised against a ServiceOrder (plain id, no
  /// relation — read through Order.serviceOrders / ClientProject when needed).
  serviceOrderId    String?
  issuedAt          DateTime @default(now())
  dueDate           DateTime?
  paidAt            DateTime?
  /// Fraction applied ONCE when the invoice turns overdue (0.02 = 2 %).
  lateFeeRate       Decimal  @default(0) @db.Decimal(5, 4)
  lateFeeAmount     Decimal  @default(0) @db.Decimal(12, 2)
  overdueNotifiedAt DateTime?

  /// T5-14 · read receipt, stamped the first time the CLIENT opens the PDF.
  /// Admin-visible only: "did they even see the bill" is the question that
  /// decides whether the next message is a reminder or a phone call.
  firstViewedAt     DateTime?
  viewCount         Int      @default(0)

  /// Money snapshot at issue time — an invoice must not change when the
  /// order row later does (refund, edit). Mirrors Order at ensureInvoice().
  serie          String   @default("A") @db.VarChar(8)
  currency       String   @default("MXN")
  subtotalAmount Decimal  @default(0.00) @db.Decimal(12, 2)  // net, before IVA
  taxRate        Decimal  @default(0.0000) @db.Decimal(5, 4)
  taxAmount      Decimal  @default(0.00) @db.Decimal(12, 2)
  totalAmount    Decimal  @default(0.00) @db.Decimal(12, 2)
  cancelledAt    DateTime?

  /// CFDI 4.0 stamping (filled by a PAC adapter — not wired yet; see
  /// src/services/cfdiProvider.js). Null = comprobante simple, not a CFDI.
  cfdiUuid       String?  @unique @db.VarChar(36)
  cfdiXmlUrl     String?
  cfdiStampedAt  DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId])
  @@index([orderId])
  @@index([status, dueDate])
  @@index([serviceOrderId])
}

model Payment {
  id                   String         @id @default(cuid())
  orderId              String
  userId               String
  paymentGateway       PaymentGateway
  gatewayTransactionId String
  gatewaySessionId     String?
  amount               Decimal        @db.Decimal(12, 2)
  currency             String         @default("MXN")
  paymentStatus        PaymentStatus  @default(pending)
  failureReason        String?        @db.Text
  paidAt               DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  refunds Refund[]

  // Idempotency: one Payment per (gateway, gatewayTransactionId).
  // Prevents duplicate Payment rows from racing webhook + capture-callback
  // deliveries. Composite chosen because gatewayTransactionId is only
  // unique within a single gateway namespace.
  @@unique([paymentGateway, gatewayTransactionId], name: "payment_gateway_tx_uq")
  @@index([orderId])
  @@index([userId])
}

model PaymentWebhook {
  id             String         @id @default(cuid())
  paymentGateway PaymentGateway
  gatewayEventId String? // x-request-id (MP) or event.id (PayPal); null = couldn't extract
  eventType      String
  payloadJson    Json
  processed      Boolean        @default(false)
  processedAt    DateTime?
  createdAt      DateTime       @default(now())

  // Idempotency: drop duplicate webhook deliveries from the same gateway.
  // Nullable column means rows without an extractable event id are still
  // accepted (MySQL treats NULLs as distinct under UNIQUE).
  @@unique([paymentGateway, gatewayEventId], name: "webhook_event_uq")
  @@index([paymentGateway, processed])
}

model Refund {
  id           String       @id @default(cuid())
  paymentId    String
  orderId      String
  amount       Decimal      @db.Decimal(12, 2)
  reason       String?      @db.Text
  refundStatus RefundStatus
  /// Tier 4 idempotency anchor: the provider's refund id (PayPal refund id,
  /// Mercado Pago refund id). Webhooks match on it before falling back to
  /// an amount match; the unique below makes a replayed webhook a no-op.
  gatewayRefundId String?   @db.VarChar(128)
  processedAt  DateTime?
  createdAt    DateTime     @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([paymentId, gatewayRefundId], name: "refund_gateway_uq")
  @@index([paymentId])
  @@index([orderId])
}

/// =============================================================
/// DOWNLOADS
/// =============================================================

model UserDownload {
  id                   String               @id @default(cuid())
  userId               String
  productId            String
  orderId              String
  orderItemId          String
  downloadAccessStatus DownloadAccessStatus @default(active)
  downloadLimit        Int?
  downloadCount        Int                  @default(0)
  lastDownloadedAt     DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  logs      DownloadLog[]

  @@unique([userId, productId, orderItemId])
  @@index([userId])
  @@index([productId])
  @@index([orderId])
  @@index([orderItemId])
}

model DownloadLog {
  id             String   @id @default(cuid())
  userId         String
  productId      String
  orderId        String
  userDownloadId String?
  /// Per-file download cap tracking. Nullable so legacy rows (pre per-file cap)
  /// stay valid; downloadService falls back to productId for those.
  productFileId  String?
  userAgent      String?  @db.Text
  ipAddress      String?
  createdAt      DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userDownload UserDownload? @relation(fields: [userDownloadId], references: [id], onDelete: SetNull)
  productFile  ProductFile?  @relation(fields: [productFileId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([productId])
  @@index([orderId])
  @@index([userDownloadId])
  @@index([productFileId])
}

/// =============================================================
/// SERVICE DELIVERY
/// =============================================================

model ServiceOrder {
  id               String             @id @default(cuid())
  orderId          String
  orderItemId      String             @unique
  userId           String
  serviceId        String
  servicePackageId String?
  status           ServiceOrderStatus @default(new)
  startDate        DateTime?
  endDate          DateTime?
  notes            String?            @db.Text
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem      OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  service        Service         @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  servicePackage ServicePackage? @relation(fields: [servicePackageId], references: [id], onDelete: SetNull)
  consultations  Consultation[]
  clientProject  ClientProject?

  @@index([orderId])
  @@index([userId])
  @@index([serviceId])
  @@index([servicePackageId])
}

model Consultation {
  id                 String             @id @default(cuid())
  serviceOrderId     String? // null for free discovery calls (no prior payment)
  serviceId          String? // direct link when no serviceOrder; informs duration / category
  userId             String
  assignedAdminId    String? // host of the meeting; nullable until assigned
  scheduledAt        DateTime // UTC start time
  endsAt             DateTime? // UTC end time — derived on create from durationMin
  durationMin        Int                @default(30)
  timezone           String             @default("UTC") // client's IANA tz captured at booking
  meetingProvider    MeetingProvider    @default(manual)
  meetingLink        String? // join URL (Google Meet / Zoom / manual)
  /// Google Calendar event id — populated when meetingProvider = google_meet.
  /// Lets the reschedule / cancel paths update the same Calendar event
  /// instead of orphaning it. Nullable for non-Google bookings.
  googleEventId      String?
  status             ConsultationStatus @default(pending)
  summaryNotes       String?            @db.Text // host's post-meeting notes
  clientNotes        String?            @db.Text // client's pre-meeting notes / agenda
  cancellationReason String?            @db.Text
  cancelledAt        DateTime?
  confirmedAt        DateTime?
  completedAt        DateTime?
  /// Signed token for guest-style cancel/reschedule via email link without login.
  confirmationToken  String?            @unique
  /// Self-relation: when this row is a reschedule of a prior consultation.
  rescheduledFromId  String?
  /// Reminder bookkeeping — set when 24h or 1h reminder dispatched.
  reminderSentAt     DateTime?
  /// Monotonic revision counter. Starts at 0; incremented on every
  /// reschedule (the new row carries parent.revision + 1). Used as the
  /// ICS SEQUENCE so calendar clients (Gmail / Outlook / Apple Mail)
  /// recognise a real update across N reschedules instead of treating
  /// the 2nd+ reschedule as a duplicate of the 1st. RFC 5545 § 3.8.7.4.
  revision           Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  serviceOrder    ServiceOrder?  @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  service         Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  user            User           @relation("UserConsultations", fields: [userId], references: [id], onDelete: Cascade)
  assignedAdmin   User?          @relation("AssignedConsultations", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  rescheduledFrom Consultation?  @relation("ConsultationReschedule", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledTo   Consultation[] @relation("ConsultationReschedule")

  /// Race-safe booking. This database is MySQL, which has no EXCLUDE
  /// constraint, so same-start collisions per host are rejected at the DB
  /// level by this unique index (P2002 → 409 in consultationService).
  /// Overlap of different-length bookings is handled by the availability
  /// check in bookConsultation, which only offers non-overlapping slots.
  clientProject   ClientProject? @relation("ConsultationProject")

  @@unique([assignedAdminId, scheduledAt])
  @@index([serviceOrderId])
  @@index([serviceId])
  @@index([userId])
  @@index([assignedAdminId])
  @@index([scheduledAt])
  @@index([status])
  @@index([rescheduledFromId])
  // Hot path · booking calendar queries upcoming slots per service in a
  // date range. The single-column [serviceId] + [scheduledAt] indexes
  // can't service both predicates together; this compound covers it.
  @@index([serviceId, scheduledAt])
}

/// =============================================================
/// AVAILABILITY (booking calendar — recurring rules + exceptions)
/// =============================================================

model AvailabilityRule {
  id              String   @id @default(cuid())
  hostUserId      String // admin who owns this availability window
  serviceId       String? // null = applies to any bookable service
  dayOfWeek       Int // 0=Sunday … 6=Saturday (per JS Date.getDay)
  startTime       String // "HH:mm" 24-hour, interpreted in `timezone`
  endTime         String // "HH:mm" 24-hour, interpreted in `timezone`
  timezone        String // IANA tz, e.g. "America/Mexico_City"
  slotDurationMin Int      @default(30)
  bufferMin       Int      @default(0) // gap inserted after each generated slot
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  host    User     @relation("HostAvailabilityRules", fields: [hostUserId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([hostUserId])
  @@index([serviceId])
  @@index([dayOfWeek])
  @@index([isActive])
  // Hot path · slot generation filters all three predicates together
  // (active rules for this host on this weekday). Compound avoids a
  // table scan when the host has many historical/inactive rules.
  @@index([hostUserId, isActive, dayOfWeek])
}

model AvailabilityException {
  id         String                    @id @default(cuid())
  hostUserId String
  /// UTC midnight of the local exception date — interpretation uses `timezone`.
  date       DateTime
  type       AvailabilityExceptionType
  /// startTime/endTime required when type=custom (adds availability outside recurring rules).
  startTime  String?
  endTime    String?
  timezone   String
  reason     String?
  createdAt  DateTime                  @default(now())

  host User @relation("HostAvailabilityExceptions", fields: [hostUserId], references: [id], onDelete: Cascade)

  @@index([hostUserId])
  @@index([date])
  @@index([type])
}

model ClientProject {
  id              String        @id @default(cuid())
  serviceOrderId  String?       @unique
  /// Free consultations (no paid ServiceOrder) open a project shell too.
  consultationId  String?       @unique
  userId          String
  assignedAdminId String?
  projectName     String
  projectStatus   ProjectStatus @default(planning)
  startDate       DateTime?
  dueDate         DateTime?
  description     String?       @db.Text
  /// Client portal (Tier 2). previewUrl is shown as a card/link; it is
  /// framed only when its host is in PREVIEW_FRAME_HOSTS (CSP frame-src).
  previewUrl      String?
  /// Set when projectStatus becomes completed/cancelled. Member writes are
  /// refused after this; reads expire PROJECT_ACCESS_GRACE_DAYS later.
  closedAt        DateTime?
  /// Tier 4 · NDA click-wrap. When true, the member portal hides milestones,
  /// files, comments and tickets until a ProjectAgreement row exists for
  /// (userId, "nda", ndaVersion). Bump ndaVersion to force re-acceptance.
  requiresNda     Boolean       @default(false)
  ndaVersion      String?       @db.VarChar(16)
  /// Tier 4 · magic-link portal. 32 random bytes hex; FRONTEND_URL/portal/<token>.
  /// Re-minting rotates it. Expires with the grace window (closed) or +90 d.
  portalToken          String?   @unique @db.VarChar(64)
  portalTokenExpiresAt DateTime?
  /// Tier 4 · retention. Set by projectPurgeJob once every file's bytes are
  /// gone (closedAt + PROJECT_PURGE_DAYS). Metadata rows are kept.
  purgedAt        DateTime?
  /// Tier 4 kill switch / handover gate: active | suspended | handover (invoiceDunningJob + admin PATCH).
  accessState     String        @default("active") @db.VarChar(16)
  /// Tier 5 · the short code a client can type, read over the phone, or find
  /// on an invoice: "MU-XXXX-XXXX", Crockford base32 without 0/O/1/I so it
  /// survives being handwritten. ~40 bits, which is why /track is rate
  /// limited (see ADR 0006). The cuid stays the primary key; this is the
  /// human-facing handle, and it is nullable so existing rows are valid
  /// until the backfill runs.
  trackingCode    String?       @unique @db.VarChar(16)

  /// T5-21 · when the seven-day review follow-up went out.
  ///
  /// The stamp is what makes it ONCE. A client who did not want to review
  /// the work after the first ask did not want to after the second either,
  /// and a third would be the message that makes them stop reading us.
  reviewRequestedAt DateTime?

  /// T5-15 · this project's Monday digest is off.
  ///
  /// Per PROJECT, not per person: a client with three projects may want the
  /// digest for the live one and not for the two winding down, and a single
  /// global switch would make them choose all or nothing.
  digestOptOut    Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  serviceOrder  ServiceOrder?      @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  consultation  Consultation?      @relation("ConsultationProject", fields: [consultationId], references: [id], onDelete: SetNull)
  user          User               @relation("UserClientProjects", fields: [userId], references: [id], onDelete: Cascade)
  assignedAdmin User?              @relation("AssignedClientProjects", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  milestones    ProjectMilestone[]
  files         ProjectFile[]
  comments      ProjectComment[]
  tickets       SupportTicket[]
  agreements    ProjectAgreement[]
  members        ProjectMember[]
  secretHandoffs SecretHandoff[]
  reviews       Review[]
  changeRequests ChangeRequest[]
  events         ProjectEvent[]
  fileRequests   ProjectFileRequest[]

  @@index([userId])
  @@index([assignedAdminId])
}

/// Tier 5 · the client-facing story of a project.
///
/// Append-only and typed. The four activityLog.create calls in
/// projectPortalService stay where they are — that is the ADMIN audit trail,
/// written for us. This is what the client is shown, which is a different
/// edit of the same events: fewer of them, in their language, with no
/// internal notes.
///
/// `visibility` is the whole design. "public" is what an anonymous tracking
/// code may see and is deliberately thin; "client" adds file names and
/// comments for someone who has signed in or holds a portal link; "admin"
/// is everything. A row is written once at the highest visibility it may
/// ever have — narrowing later is a filter, widening later is a leak.
model ProjectEvent {
  id             String   @id @default(cuid())
  projectId      String
  /// Closed list — see PROJECT_EVENT_TYPES in src/services/projectEventService.js.
  type           String   @db.VarChar(32)
  title          String
  titleEs        String?
  detail         String?  @db.Text
  detailEs       String?  @db.Text
  /// "admin" | "client" | "system" — who caused it, not who may see it.
  actorRole      String   @db.VarChar(16)
  /// "public" | "client" | "admin"
  visibility     String   @default("client") @db.VarChar(16)
  milestoneId    String?
  fileId         String?
  fileRequestId  String?
  invoiceId      String?
  createdAt      DateTime @default(now())

  project ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([projectId, visibility])
}

/// Tier 5 · "send me the thing", as a row rather than an email thread.
///
/// A request is answered by exactly one file (fulfilledFileId), which is why
/// that side is unique; the other side of the relation lets several uploads
/// hang off one request while the client tries again after a rejection.
model ProjectFileRequest {
  id              String    @id @default(cuid())
  projectId       String
  milestoneId     String?
  title           String
  titleEs         String?
  instructions    String?   @db.Text
  instructionsEs  String?   @db.Text
  /// Comma-separated extension allowlist, e.g. ".pdf,.docx". Enforced on
  /// upload; advisory in the UI.
  acceptExt       String?   @db.VarChar(128)
  dueAt           DateTime?
  /// requested | submitted | accepted | rejected | cancelled
  status          String    @default("requested") @db.VarChar(16)
  requestedById   String?
  fulfilledFileId String?   @unique
  reviewNote      String?   @db.Text
  remindedAt      DateTime?
  submittedAt     DateTime?
  closedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project       ClientProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone     ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  requestedBy   User?             @relation("RequestedFileRequests", fields: [requestedById], references: [id], onDelete: SetNull)
  fulfilledFile ProjectFile?      @relation("RequestFulfilment", fields: [fulfilledFileId], references: [id], onDelete: SetNull)
  uploads       ProjectFile[]     @relation("RequestUploads")

  @@index([projectId, status])
  @@index([dueAt])
}

/// T5-13 · a credential in transit, and nothing else.
///
/// Credentials were arriving as files: a hosting password in a .txt, the
/// registrar login in a screenshot, WiFi keys in the body of a support
/// ticket. Every one of those lands in `storage/projects/` and stays there
/// for the retention window, readable by anything that can read the disk and
/// included in any handover ZIP built later.
///
/// This row holds AES-256-GCM ciphertext under SECRET_HANDOFF_KEY and can be
/// read exactly ONCE — the reveal stamps `viewedAt` and the ciphertext is
/// wiped in the same write. Both directions: the client hands over a hosting
/// password, and at handover we hand back the admin credentials.
///
/// What is NOT encrypted is `label`, deliberately: both parties need to see
/// "cPanel password" in a list to know what is waiting, and the timeline
/// events carry the label only.
model SecretHandoff {
  id          String    @id @default(cuid())
  projectId   String
  /// "to_client" (we are handing something over) or "to_admin" (the client
  /// is sending us something). It decides who may reveal it, and it is the
  /// whole access model: the other party wrote it and must not read it back.
  direction   String    @db.VarChar(16)
  /// What it is, in the clear. Never the value.
  label       String    @db.VarChar(160)
  /// AES-256-GCM. Null once revealed — the wipe is the point.
  ciphertext  String?   @db.Text
  iv          String?   @db.VarChar(32)
  tag         String?   @db.VarChar(32)
  /// Default seven days. An unclaimed credential is a liability, not an
  /// inbox.
  expiresAt   DateTime
  /// Set the moment it is read. Non-null means gone.
  viewedAt    DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  project   ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User?         @relation("CreatedSecretHandoffs", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([projectId, direction])
  @@index([expiresAt])
}

/// T5-17 · the other people on the client's side.
///
/// Schools were the driver and they are the ordinary case, not the exotic
/// one: a director who approves the work and signs off the money, and an IT
/// person who uploads the files and answers the technical questions. Before
/// this the project belonged to exactly one User row, so the second person
/// either shared a password or forwarded every email — and every approval
/// came from an account that was not the person approving.
///
/// `ClientProject.userId` STAYS the owner. This is an addition, not a
/// replacement: the owner is who the project was sold to, who is billed, and
/// the fallback for every notification. A member is somebody else who may
/// also reach it.
///
/// A member need not have an account. `email` is the identity that always
/// exists; `userId` is filled in when they sign in with that address, and
/// until then they reach the project through the tracking code and a PIN
/// sent to their own inbox (T5-8).
model ProjectMember {
  id         String    @id @default(cuid())
  projectId  String
  /// Filled in when this person has an account. Null is normal.
  userId     String?
  /// The identity that always exists. Lower-cased on write so a lookup is a
  /// lookup and not a guess.
  email      String    @db.VarChar(190)
  name       String?   @db.VarChar(160)
  /// "owner" | "approver" | "viewer".
  ///
  /// Only owner and approver may approve a milestone, accept a change
  /// request or start a payment — the three actions that commit the client
  /// to something. A viewer may still upload, comment and open a ticket:
  /// the IT person in the driving example is exactly that, and a role that
  /// could not type would be useless to them.
  role       String    @default("viewer") @db.VarChar(16)
  invitedAt  DateTime  @default(now())
  /// Set the first time they actually reach the project.
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  project ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?         @relation("ProjectMemberships", fields: [userId], references: [id], onDelete: SetNull)

  /// One row per address per project. A second invitation is an edit.
  @@unique([projectId, email])
  @@index([userId])
  @@index([projectId, role])
}

model ProjectMilestone {
  id          String          @id @default(cuid())
  projectId   String
  title       String
  description String?         @db.Text
  status      MilestoneStatus @default(pending)
  dueDate     DateTime?
  /// T5-12 · when we now think this will actually land.
  ///
  /// Distinct from dueDate, and the distinction is the whole feature.
  /// dueDate is the COMMITMENT — what was agreed, and what a slip is measured
  /// against. estimatedAt is the current honest belief. A client who can see
  /// both knows whether a date has moved; a client who can only see one
  /// discovers it on the day.
  estimatedAt DateTime?
  completedAt DateTime?
  /// One-click client approval (Tier 2). approvedById is the client user.
  approvedAt         DateTime?
  approvedById       String?
  /// Client pressed "request changes": when + what they said.
  changesRequestedAt DateTime?
  clientNote         String?   @db.Text
  sortOrder   Int             @default(0)

  project  ClientProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  comments ProjectComment[]
  files    ProjectFile[]
  fileRequests ProjectFileRequest[]

  @@index([projectId])
}

model ProjectFile {
  id           String   @id @default(cuid())
  projectId    String
  uploadedById String?
  /// "admin" | "client" — who put the file there (gallery grouping, purge).
  uploadedByRole   String?  @db.VarChar(16)
  /// Optional anchors: a milestone the file belongs to, or the support
  /// message it was attached to (tickets reuse this table for attachments).
  milestoneId      String?
  supportMessageId String?
  fileName     String
  filePath     String
  fileType     String?
  fileSize     Int?
  /// Tier 4 handover gate: deliverables are served only when the project
  /// has no outstanding balance. Default false = plain shared file.
  isDeliverable    Boolean  @default(false)
  /// T5-14 · read receipt. Stamped the first time the CLIENT streams it —
  /// never when an admin opens their own file, which would make every
  /// receipt a lie about the person it names.
  ///
  /// Admin-visible only. A client being shown "you opened this on Tuesday"
  /// is surveillance; an operator knowing whether the deliverable they sent
  /// was ever looked at is the difference between chasing and waiting.
  firstViewedAt DateTime?
  viewCount     Int      @default(0)

  /// Tier 4 · retention. Bytes unlinked by projectPurgeJob; row kept as audit.
  purgedAt     DateTime?
  /// Tier 5 · the document request this upload answers, if any. A file can
  /// exist without one (an ordinary shared file); a request points back
  /// through fulfilledFileId.
  fileRequestId    String?
  createdAt    DateTime @default(now())

  project        ClientProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy     User?             @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  milestone      ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  supportMessage SupportMessage?   @relation(fields: [supportMessageId], references: [id], onDelete: SetNull)
  comments       ProjectComment[]
  fileRequest    ProjectFileRequest? @relation("RequestUploads", fields: [fileRequestId], references: [id], onDelete: SetNull)
  fulfils        ProjectFileRequest? @relation("RequestFulfilment")

  @@index([projectId])
  @@index([uploadedById])
  @@index([milestoneId])
  @@index([supportMessageId])
}

/// Tier 2 · threaded feedback on a project, optionally anchored to a
/// milestone or a file ("visual commenting" = comment on the thing, not
/// pixel pins). Both sides write; admins can resolve.
model ProjectComment {
  id          String    @id @default(cuid())
  projectId   String
  milestoneId String?
  fileId      String?
  authorId    String
  authorRole  String    @db.VarChar(16) // "admin" | "client"
  body        String    @db.Text
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  project   ClientProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  file      ProjectFile?      @relation(fields: [fileId], references: [id], onDelete: SetNull)
  author    User              @relation("UserProjectComments", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([milestoneId])
  @@index([authorId])
}

/// =============================================================
/// SUPPORT, CONTACT, NEWSLETTER
/// =============================================================

model SupportTicket {
  id              String         @id @default(cuid())
  ticketNumber    String         @unique
  userId          String
  subject         String
  /// Initial message body stored directly on ticket
  message         String         @db.Text
  status          TicketStatus   @default(open)
  priority        TicketPriority @default(medium)
  /// M16 — drives the admin "Open refund modal" deep-link on tickets that
  /// originated from a member-side refund request.
  category        TicketCategory @default(general)
  /// M16 — optional FK to an Order. Populated when the ticket was created
  /// via the "Request refund" flow on DashboardOrders so admins can jump
  /// straight to AdminOrderDetail without copy-pasting the order number.
  orderId         String?
  /// Tier 2 — ticket opened from inside a client project (status shown next
  /// to the project's; attachments land in ProjectFile via supportMessageId).
  projectId       String?
  assignedAdminId String?
  resolvedAt      DateTime?
  closedAt        DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user          User             @relation("UserSupportTickets", fields: [userId], references: [id], onDelete: Cascade)
  assignedAdmin User?            @relation("AssignedSupportTickets", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  order         Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  project       ClientProject?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messages      SupportMessage[]

  @@index([userId])
  @@index([assignedAdminId])
  @@index([status])
  @@index([category])
  @@index([orderId])
  @@index([projectId])
}

model SupportMessage {
  id            String     @id @default(cuid())
  ticketId      String
  senderId      String
  /// message body
  message       String     @db.Text
  senderRole    SenderRole @default(member)
  attachmentUrl String?
  isRead        Boolean    @default(false)
  createdAt     DateTime   @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  /// Multi-file attachments (Tier 2) — stored as ProjectFile rows so they
  /// share the private storage path, scan and stream endpoint.
  attachments ProjectFile[]

  @@index([ticketId])
  @@index([senderId])
}

/// Self-audit diagnostic submissions.
/// Created when a visitor completes the /self-audit tool and clicks
/// "Email my report". Persisted before the outbound email is sent so
/// leads are never lost on SMTP failure.
model DiagnosticSubmission {
  id              String   @id @default(cuid())
  name            String
  email           String
  organization    String?
  audience        DiagnosticAudience
  overallScore    Int      // 0-100 normalised
  tier            DiagnosticTier
  sectionScores   Json     // { A: { pct, raw, max }, ... }
  scores          Json     // raw { "A.1": 3, ... }
  topPriorities   Json     // [{id,svc,title,score,tier}]
  matchedBundle   String?  // Solution bundle name or null
  emailSent       Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([email])
  @@index([audience])
  @@index([createdAt])
}

model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String    @db.Text
  status    ContactMessageStatus @default(new)
  repliedAt DateTime?
  createdAt DateTime  @default(now())

  // T3 · funnel attribution + abuse forensics (all optional, set by the API)
  intent    String? @db.VarChar(64)   // plan | proposal | service | …  (from ?intent=)
  audience  String? @db.VarChar(32)   // education | business | professional
  tier      String? @db.VarChar(32)   // pricing tier the lead was looking at
  source    String? @db.VarChar(64)   // contact-form | footer | referrer path
  locale    String? @db.VarChar(8)    // en | es
  ipAddress String? @db.VarChar(64)
  userAgent String? @db.VarChar(255)

  @@index([status, createdAt])
  @@index([createdAt])
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  status         NewsletterStatus @default(subscribed)
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?

  // B07 · token-based unsubscribe + attribution
  unsubscribeToken String? @unique
  source           String?
  name             String?
}

/// =============================================================
/// NOTIFICATIONS AND EMAILS
/// =============================================================

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String    @db.Text
  isRead    Boolean   @default(false)
  readAt    DateTime?
  linkUrl   String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// T1-3 · the bell reads (userId, newest first) and (userId, unread);
  /// the two single-column indexes served neither shape well.
  @@index([userId, createdAt])
  @@index([userId, isRead])
}

model EmailTemplate {
  id        String   @id @default(cuid())
  key       String
  subject   String
  htmlBody  String   @db.LongText
  textBody  String?  @db.LongText
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
  locale    String   @default("en")

  @@unique([key, locale])
  @@index([locale])
}

/// Delivery state of one EmailLog row (roadmap step 41 · single email layer).
enum EmailStatus {
  queued
  sent
  failed
  bounced
  skipped
}

model EmailLog {
  id                String      @id @default(cuid())
  userId            String?
  emailTo           String
  templateKey       String?
  subject           String
  status            EmailStatus @default(queued)
  providerMessageId String?
  sentAt            DateTime?
  errorMessage      String?     @db.Text
  /// Number of delivery attempts made so far (1 after the first send).
  attempts          Int         @default(0)
  /// When the retry job may re-attempt delivery. Null = no retry scheduled.
  nextAttemptAt     DateTime?
  /// Stored mail options (from/to/subject/html/text/headers/ics) so the
  /// retry job can re-send without re-rendering. Null for permanent rows.
  payload           Json?
  createdAt         DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status, nextAttemptAt])
  /// T1-3 · retention sweep by age, and the abandoned-cart / campaign
  /// dedupe shape (userId + templateKey + recent) that was a full scan.
  @@index([createdAt])
  @@index([userId, templateKey, createdAt])
}

/// =============================================================
/// CMS AND MEDIA
/// =============================================================

/// DEPRECATED (2026-08) · feature removed from the app; no code reads or writes this table.
/// Kept so `prisma db push` does not drop production data. Drop in a dedicated,
/// backed-up migration once you have confirmed nothing else depends on it.
model Page {
  id              String     @id @default(cuid())
  title           String
  slug            String     @unique
