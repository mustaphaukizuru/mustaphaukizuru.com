  contentJson     Json?
  contentHtml     String?    @db.LongText
  excerpt         String?    @db.Text
  metaTitle       String?
  metaDescription String?    @db.Text
  status          PageStatus @default(draft)
  publishedAt     DateTime?
  createdById     String?
  updatedById     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  createdBy         User?   @relation("CreatedPages", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy         User?   @relation("UpdatedPages", fields: [updatedById], references: [id], onDelete: SetNull)
  titleEs           String?
  contentEs         String? @db.Text
  metaTitleEs       String?
  metaDescriptionEs String? @db.Text

  @@index([createdById])
  @@index([updatedById])
  @@index([status])
}

model MediaLibrary {
  id           String   @id @default(cuid())
  fileName     String
  filePath     String
  fileUrl      String?
  fileType     String?
  /// fileSize in bytes as Int
  fileSize     Int?
  mimeType     String?
  altText      String?
  uploadedById String?
  createdAt    DateTime @default(now())

  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([uploadedById])
}

/// =============================================================
/// SYSTEM LOGGING
