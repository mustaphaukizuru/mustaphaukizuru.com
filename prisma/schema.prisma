/// =============================================================
/// USERS
/// =============================================================

/// Step 42 · schema tidy. Named AccountRole (not UserRole) because a
/// `UserRole` join model already exists in this schema.
enum AccountRole {
  member
  admin
}

enum ContactMessageStatus {
  new
  read
  replied
}

enum NewsletterStatus {
  pending
  subscribed
  unsubscribed
}

enum CampaignRecipientStatus {
  queued
  sent
  failed
  bounced
}

enum DiagnosticAudience {
  EDU
  SMB
  IND
}

enum DiagnosticTier {
  Foundation
  Stabilizing
  Optimizing
  Mature
}

model User {
  id                     String           @id @default(cuid())
  fullName               String
  email                  String           @unique
  passwordHash           String?
  role                   AccountRole      @default(member)
  googleId               String?          @unique
  microsoftId            String?          @unique
  facebookId             String?          @unique
  avatarUrl              String?
  authProvider           String           @default("local")
  phone                  String?
  company                String?
  status                 UserStatus       @default(active)
  emailVerifiedAt        DateTime?
  lastLoginAt            DateTime?
  /// Token-revocation watermark. Any JWT with iat < tokensValidFrom is
  /// rejected by authMiddleware. Set whenever a credential changes (password
  /// reset, 2FA enable) or when the user manually signs out everywhere.
  /// NULL means "no revocations yet" — all valid JWTs pass.
  tokensValidFrom        DateTime?

  /// T3-5 · account lockout.
  ///
  /// The login limiter is per IP, which is the wrong axis for the attack it
  /// most needs to stop: a password-spraying botnet has thousands of IPs and
  /// one address per attempt, so every request looks like a first attempt.
  /// These count per ACCOUNT, which is where the damage would be.
  ///
  /// Reset to zero on any successful sign-in — a person who mistypes twice
  /// and then gets it right has not done anything suspicious.
  failedLoginAttempts    Int              @default(0)
  /// Set when the threshold is crossed; cleared implicitly by expiring.
  lockedUntil            DateTime?
  resetPasswordToken     String?
  resetPasswordExpires   DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  profile                UserProfile?
  userRoles              UserRole[]
  sessions               Session[]
  authOtps               AuthOtp[]
  passwordResets         PasswordReset[]
  orders                 Order[]
  carts                  Cart[]
  payments               Payment[]
  couponsUsed            CouponUsage[]
  reviews                Review[]         @relation("AuthoredReviews")
  adminReplies           Review[]         @relation("AdminReviewReplies")
  reviewVotes            ReviewVote[]
  createdRecommendations Recommendation[] @relation("CreatedRecommendations")
  downloadLogs           DownloadLog[]
  userDownloads          UserDownload[]
  createdProducts        Product[]        @relation("CreatedProducts")
  createdServices        Service[]        @relation("CreatedServices")
  createdPortfolios      Portfolio[]      @relation("CreatedPortfolios")
  serviceOrders          ServiceOrder[]
  consultations          Consultation[]   @relation("UserConsultations")
  assignedConsultations  Consultation[]   @relation("AssignedConsultations")
  clientProjects         ClientProject[]  @relation("UserClientProjects")
  assignedProjects       ClientProject[]  @relation("AssignedClientProjects")
  projectMemberships    ProjectMember[]  @relation("ProjectMemberships")
  createdSecretHandoffs SecretHandoff[]  @relation("CreatedSecretHandoffs")
  requestedFileRequests  ProjectFileRequest[] @relation("RequestedFileRequests")
  projectFiles           ProjectFile[]
  projectComments        ProjectComment[] @relation("UserProjectComments")
  projectAgreements      ProjectAgreement[]
  supportTickets         SupportTicket[]  @relation("UserSupportTickets")
  assignedTickets        SupportTicket[]  @relation("AssignedSupportTickets")
  supportMessages        SupportMessage[]
  notifications          Notification[]
  emailLogs              EmailLog[]
  uploadedMedia          MediaLibrary[]
  createdPages           Page[]           @relation("CreatedPages")
  updatedPages           Page[]           @relation("UpdatedPages")
  activityLogs           ActivityLog[]
  adminAuditLogs         AdminAuditLog[]
  addresses              Address[]
  twoFactorAuth          TwoFactorAuth?

  // Booking — host-side relations (used when this user is the consultation host)
  hostAvailabilityRules      AvailabilityRule[]      @relation("HostAvailabilityRules")
  hostAvailabilityExceptions AvailabilityException[] @relation("HostAvailabilityExceptions")
}

model UserProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  companyName  String?
  jobTitle     String?
  country      String?
  city         String?
  addressLine1 String?
  addressLine2 String?
  stateRegion  String?
  postalCode   String?
  bio          String?  @db.Text
  timezone     String?
  websiteUrl   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthOtp {
  id        String    @id @default(cuid())
  userId    String?
  email     String
  otpCode   String
  purpose   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  token     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Session {
  id             String   @id @default(cuid())
  userId         String
  ipAddress      String?
  userAgent      String?  @db.Text
  deviceName     String?
  lastActivityAt DateTime @default(now())
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  /// T1-3 · expired-session sweep (retentionJob)
  @@index([expiresAt])
}

