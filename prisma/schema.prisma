/// =============================================================
/// PRISMA CLIENT + DATABASE CONNECTION
/// =============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// =============================================================
/// ENUMS
/// =============================================================

enum UserStatus {
  active
  suspended
  pending
}

enum CartStatus {
  active
  converted
  abandoned
}

enum OrderStatus {
  pending
  paid
  failed
  cancelled
  refunded
}

enum PaymentStatus {
  pending
  paid
  failed
  cancelled
  refunded
}

enum PaymentGateway {
  mercadopago
  paypal
}

enum ProductStatus {
  draft
  published
  archived
}

enum ServiceStatus {
  draft
  published
  archived
}

enum ItemType {
  product
  service
}

enum DownloadAccessStatus {
  active
  revoked
}

enum ServiceOrderStatus {
  new
  active
  on_hold
  completed
  cancelled
}

enum ConsultationStatus {
  scheduled
  completed
  cancelled
  rescheduled
}

enum ProjectStatus {
  planning
  in_progress
  review
  completed
  cancelled
}

enum MilestoneStatus {
  pending
  in_progress
  completed
}

enum TicketStatus {
  open
  in_progress
  resolved
  closed
}

enum TicketPriority {
  low
  medium
  high
}

enum SenderRole {
  member
  admin
  system
}

enum DiscountType {
  percentage
  fixed
}

enum PageStatus {
  draft
  published
}

enum PageType {
  public
  legal
  landing
}

enum ProductImageRole {
  cover
  preview
  detail
  usage
  feature
  extra
}

/// =============================================================
/// USERS
/// =============================================================

model User {
  id                   String     @id @default(cuid())
  fullName             String
  email                String     @unique
  passwordHash         String?
  role                 String     @default("member")
  googleId             String?    @unique
  avatarUrl            String?
  authProvider         String     @default("local")
  phone                String?
  company              String?
  status               UserStatus @default(active)
  emailVerifiedAt      DateTime?
  lastLoginAt          DateTime?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  profile               UserProfile?
  userRoles             UserRole[]
  sessions              Session[]
  authOtps              AuthOtp[]
  passwordResets        PasswordReset[]
  orders                Order[]
  carts                 Cart[]
  payments              Payment[]
  couponsUsed           CouponUsage[]
  reviews               ProductReview[]
  downloadLogs          DownloadLog[]
  userDownloads         UserDownload[]
  createdProducts       Product[]        @relation("CreatedProducts")
  createdServices       Service[]        @relation("CreatedServices")
  serviceOrders         ServiceOrder[]
  consultations         Consultation[]   @relation("UserConsultations")
  assignedConsultations Consultation[]   @relation("AssignedConsultations")
  clientProjects        ClientProject[]  @relation("UserClientProjects")
  assignedProjects      ClientProject[]  @relation("AssignedClientProjects")
  projectFiles          ProjectFile[]
  supportTickets        SupportTicket[]  @relation("UserSupportTickets")
  assignedTickets       SupportTicket[]  @relation("AssignedSupportTickets")
  supportMessages       SupportMessage[]
  notifications         Notification[]
  emailLogs             EmailLog[]
  uploadedMedia         MediaLibrary[]
  createdPages          Page[]           @relation("CreatedPages")
  updatedPages          Page[]           @relation("UpdatedPages")
  activityLogs          ActivityLog[]
  adminAuditLogs        AdminAuditLog[]
}

model UserProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  companyName  String?
  jobTitle     String?
  country      String?
  city         String?
  addressLine1 String?
  addressLine2 String?
  stateRegion  String?
  postalCode   String?
  bio          String?  @db.Text
  timezone     String?
  websiteUrl   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthOtp {
  id        String    @id @default(cuid())
  userId    String?
  email     String
  otpCode   String
  purpose   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  token     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Session {
  id             String   @id @default(cuid())
  userId         String
  ipAddress      String?
  userAgent      String?  @db.Text
  deviceName     String?
  lastActivityAt DateTime @default(now())
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?  @db.Text
  createdAt   DateTime @default(now())

  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model AdminPermission {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  createdAt DateTime @default(now())

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

/// =============================================================
/// PRODUCTS
/// =============================================================

model ProductCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?  @db.Text
  icon        String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Product {
  id               String        @id @default(cuid())
  categoryId       String?
  title            String
  slug             String        @unique
  shortDescription String?       @db.Text
  description      String?       @db.Text
  fullDescription  String?       @db.Text
  price            Decimal       @db.Decimal(12, 2)
  currency         String        @default("USD")
  productType      String        @default("downloadable")
  status           ProductStatus @default(draft)
  sku              String?       @unique
  category         String?
  isActive         Boolean       @default(true)
  isFeatured       Boolean       @default(false)
  isNew            Boolean       @default(false)
  downloadUrl      String?
  fileName         String?
  /// fileSize stored as Int (supports files up to 2GB)
  fileSize         Int?
  fileType         String?
  version          String?
  metaTitle        String?
  metaDescription  String?       @db.Text
  publishedAt      DateTime?
  createdById      String?
  rating           Float         @default(0)
  reviewCount      Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  categoryRef   ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy     User?            @relation("CreatedProducts", fields: [createdById], references: [id], onDelete: SetNull)
  images        ProductImage[]
  files         ProductFile[]
  features      ProductFeature[]
  orderItems    OrderItem[]
  downloadLogs  DownloadLog[]
  userDownloads UserDownload[]
  tags          ProductTagMap[]
  reviews       ProductReview[]
  cartItems     CartItem[]

  @@index([categoryId])
  @@index([createdById])
  @@index([status])
  @@index([isActive])
  @@index([isFeatured])
}

model ProductFeature {
  id          String @id @default(cuid())
  productId   String
  featureText String @db.Text
  sortOrder   Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductFile {
  id         String   @id @default(cuid())
  productId  String
  fileName   String
  filePath   String
  fileType   String?
  /// fileSize in bytes as Int
  fileSize   Int?
  version    String?
  isPrimary  Boolean  @default(false)
  uploadedAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductImage {
  id        String           @id @default(cuid())
  productId String
  url       String
  altText   String?
  imageRole ProductImageRole @default(cover)
  isPrimary Boolean          @default(false)
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductTag {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  products ProductTagMap[]
}

model ProductTagMap {
  id        String @id @default(cuid())
  productId String
  tagId     String

  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     ProductTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([productId, tagId])
  @@index([productId])
  @@index([tagId])
}

model ProductReview {
  id                 String   @id @default(cuid())
  productId          String
  userId             String
  rating             Int
  reviewText         String?  @db.Text
  isVerifiedPurchase Boolean  @default(false)
  createdAt          DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([userId])
}

/// =============================================================
/// SERVICES
/// =============================================================

model Service {
  id               String        @id @default(cuid())
  title            String
  slug             String        @unique
  shortDescription String        @db.Text
  fullDescription  String?       @db.Text
  basePrice        Decimal       @default(0.00) @db.Decimal(12, 2)
  currency         String        @default("USD")
  deliveryType     String
  status           ServiceStatus @default(draft)
  isFeatured       Boolean       @default(false)
  metaTitle        String?
  metaDescription  String?       @db.Text
  createdById      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  createdBy     User?            @relation("CreatedServices", fields: [createdById], references: [id], onDelete: SetNull)
  features      ServiceFeature[]
  packages      ServicePackage[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  serviceOrders ServiceOrder[]

  @@index([createdById])
  @@index([status])
}

model ServiceFeature {
  id          String @id @default(cuid())
  serviceId   String
  featureText String @db.Text
  sortOrder   Int    @default(0)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

model ServicePackage {
  id          String   @id @default(cuid())
  serviceId   String
  name        String
  description String?  @db.Text
  price       Decimal  @db.Decimal(12, 2)
  currency    String   @default("USD")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  service       Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceOrders ServiceOrder[]

  @@index([serviceId])
}

/// =============================================================
/// CART, ORDERS, PAYMENTS
/// =============================================================

model Cart {
  id           String     @id @default(cuid())
  userId       String?
  sessionToken String?
  status       CartStatus @default(active)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([userId])
  @@index([sessionToken])
}

model CartItem {
  id            String   @id @default(cuid())
  cartId        String
  itemType      ItemType
  productId     String?
  serviceId     String?
  titleSnapshot String
  priceSnapshot Decimal  @db.Decimal(12, 2)
  quantity      Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cart    Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@index([productId])
  @@index([serviceId])
}

model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(12, 2)
  usageLimit    Int?
  usedCount     Int          @default(0)
  startsAt      DateTime?
  expiresAt     DateTime?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())

  orders Order[]
  usages CouponUsage[]
}

model CouponUsage {
  id       String   @id @default(cuid())
  couponId String
  userId   String
  orderId  String?
  usedAt   DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([userId])
  @@index([orderId])
}

model Order {
  id                 String      @id @default(cuid())
  orderNumber        String      @unique
  userId             String?
  customerName       String
  customerEmail      String
  billingName        String?
  billingEmail       String?
  billingPhone       String?
  billingCountry     String?
  billingCity        String?
  billingStateRegion String?
  billingPostalCode  String?
  status             OrderStatus @default(pending)
  subtotalAmount     Decimal     @default(0.00) @db.Decimal(12, 2)
  discountAmount     Decimal     @default(0.00) @db.Decimal(12, 2)
  serviceFeeAmount   Decimal     @default(0.00) @db.Decimal(12, 2)
  totalAmount        Decimal     @db.Decimal(12, 2)
  currency           String      @default("USD")
  couponId           String?
  termsAcceptedAt          DateTime?
  mercadoPagoPreferenceId  String?
  paidAt             DateTime?
  notes              String?     @db.Text
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  coupon        Coupon?        @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  invoices      Invoice[]
  payments      Payment[]
  refunds       Refund[]
  downloadLogs  DownloadLog[]
  userDownloads UserDownload[]
  couponUsages  CouponUsage[]
  serviceOrders ServiceOrder[]

  @@index([userId])
  @@index([couponId])
  @@index([status])
  @@index([createdAt])
  @@index([userId, status])    // compound: member dashboard filter by user+status
  @@index([status, createdAt]) // compound: admin order list sorted by date+status
}

model OrderItem {
  id                  String   @id @default(cuid())
  orderId             String
  itemType            ItemType @default(product)
  productId           String?
  serviceId           String?
  title               String
  titleSnapshot       String?
  descriptionSnapshot String?  @db.Text
  price               Decimal? @db.Decimal(12, 2)
  unitPrice           Decimal? @db.Decimal(12, 2)
  quantity            Int
  lineTotal           Decimal? @db.Decimal(12, 2)
  createdAt           DateTime @default(now())

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  service       Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  userDownloads UserDownload[]
  serviceOrders ServiceOrder[]

  @@index([orderId])
  @@index([productId])
  @@index([serviceId])
  @@index([orderId, productId]) // compound: entitlement lookup
}

model Invoice {
  id            String   @id @default(cuid())
  orderId       String
  invoiceNumber String   @unique
  invoicePdfUrl String?
  issuedAt      DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId])
  @@index([orderId])
}

model Payment {
  id                   String         @id @default(cuid())
  orderId              String
  userId               String
  paymentGateway       PaymentGateway
  gatewayTransactionId String
  gatewaySessionId     String?
  amount               Decimal        @db.Decimal(12, 2)
  currency             String         @default("USD")
  paymentStatus        PaymentStatus  @default(pending)
  failureReason        String?        @db.Text
  paidAt               DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  refunds Refund[]

  @@index([orderId])
  @@index([userId])
}

model PaymentWebhook {
  id             String         @id @default(cuid())
  paymentGateway PaymentGateway
  eventType      String
  payloadJson    Json
  processed      Boolean        @default(false)
  processedAt    DateTime?
  createdAt      DateTime       @default(now())
}

model Refund {
  id           String    @id @default(cuid())
  paymentId    String
  orderId      String
  amount       Decimal   @db.Decimal(12, 2)
  reason       String?   @db.Text
  refundStatus String
  processedAt  DateTime?
  createdAt    DateTime  @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([orderId])
}

/// =============================================================
/// DOWNLOADS
/// =============================================================

model UserDownload {
  id                   String               @id @default(cuid())
  userId               String
  productId            String
  orderId              String
  orderItemId          String
  downloadAccessStatus DownloadAccessStatus @default(active)
  downloadLimit        Int?
  downloadCount        Int                  @default(0)
  lastDownloadedAt     DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  logs      DownloadLog[]

  @@unique([userId, productId, orderItemId])
  @@index([userId])
  @@index([productId])
  @@index([orderId])
  @@index([orderItemId])
}

model DownloadLog {
  id             String   @id @default(cuid())
  userId         String
  productId      String
  orderId        String
  userDownloadId String?
  userAgent      String?  @db.Text
  ipAddress      String?
  createdAt      DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userDownload UserDownload? @relation(fields: [userDownloadId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([productId])
  @@index([orderId])
  @@index([userDownloadId])
}

/// =============================================================
/// SERVICE DELIVERY
/// =============================================================

model ServiceOrder {
  id               String             @id @default(cuid())
  orderId          String
  orderItemId      String             @unique
  userId           String
  serviceId        String
  servicePackageId String?
  status           ServiceOrderStatus @default(new)
  startDate        DateTime?
  endDate          DateTime?
  notes            String?            @db.Text
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem      OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  service        Service         @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  servicePackage ServicePackage? @relation(fields: [servicePackageId], references: [id], onDelete: SetNull)
  consultations  Consultation[]
  clientProject  ClientProject?

  @@index([orderId])
  @@index([userId])
  @@index([serviceId])
  @@index([servicePackageId])
}

model Consultation {
  id              String             @id @default(cuid())
  serviceOrderId  String
  userId          String
  assignedAdminId String?
  scheduledAt     DateTime
  meetingLink     String?
  status          ConsultationStatus @default(scheduled)
  summaryNotes    String?            @db.Text
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  serviceOrder  ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  user          User         @relation("UserConsultations", fields: [userId], references: [id], onDelete: Cascade)
  assignedAdmin User?        @relation("AssignedConsultations", fields: [assignedAdminId], references: [id], onDelete: SetNull)

  @@index([serviceOrderId])
  @@index([userId])
  @@index([assignedAdminId])
}

model ClientProject {
  id              String        @id @default(cuid())
  serviceOrderId  String        @unique
  userId          String
  assignedAdminId String?
  projectName     String
  projectStatus   ProjectStatus @default(planning)
  startDate       DateTime?
  dueDate         DateTime?
  description     String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  serviceOrder  ServiceOrder @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  user          User         @relation("UserClientProjects", fields: [userId], references: [id], onDelete: Cascade)
  assignedAdmin User?        @relation("AssignedClientProjects", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  milestones    ProjectMilestone[]
  files         ProjectFile[]

  @@index([userId])
  @@index([assignedAdminId])
}

model ProjectMilestone {
  id          String          @id @default(cuid())
  projectId   String
  title       String
  description String?         @db.Text
  status      MilestoneStatus @default(pending)
  dueDate     DateTime?
  completedAt DateTime?
  sortOrder   Int             @default(0)

  project ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectFile {
  id           String   @id @default(cuid())
  projectId    String
  uploadedById String?
  fileName     String
  filePath     String
  fileType     String?
  createdAt    DateTime @default(now())

  project    ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User?         @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([uploadedById])
}

/// =============================================================
/// SUPPORT, CONTACT, NEWSLETTER
/// =============================================================

model SupportTicket {
  id              String         @id @default(cuid())
  ticketNumber    String         @unique
  userId          String
  subject         String
  /// Initial message body stored directly on ticket
  message         String         @db.Text
  status          TicketStatus   @default(open)
  priority        TicketPriority @default(medium)
  assignedAdminId String?
  resolvedAt      DateTime?
  closedAt        DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user          User             @relation("UserSupportTickets", fields: [userId], references: [id], onDelete: Cascade)
  assignedAdmin User?            @relation("AssignedSupportTickets", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  messages      SupportMessage[]

  @@index([userId])
  @@index([assignedAdminId])
  @@index([status])
}

model SupportMessage {
  id            String     @id @default(cuid())
  ticketId      String
  senderId      String
  /// message body
  message       String     @db.Text
  senderRole    SenderRole @default(member)
  attachmentUrl String?
  isRead        Boolean    @default(false)
  createdAt     DateTime   @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User          @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([senderId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String   @db.Text
  status    String   @default("new")
  repliedAt DateTime?
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  status         String    @default("subscribed")
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?
}

/// =============================================================
/// NOTIFICATIONS AND EMAILS
/// =============================================================

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String    @db.Text
  isRead    Boolean   @default(false)
  readAt    DateTime?
  linkUrl   String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model EmailTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  subject   String
  htmlBody  String   @db.LongText
  textBody  String?  @db.LongText
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model EmailLog {
  id                String    @id @default(cuid())
  userId            String?
  emailTo           String
  templateKey       String?
  subject           String
  status            String    @default("queued")
  providerMessageId String?
  sentAt            DateTime?
  errorMessage      String?   @db.Text
  createdAt         DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

/// =============================================================
/// CMS AND MEDIA
/// =============================================================

model Page {
  id              String     @id @default(cuid())
  title           String
  slug            String     @unique
  pageType        PageType   @default(public)
  contentJson     Json?
  contentHtml     String?    @db.LongText
  excerpt         String?    @db.Text
  metaTitle       String?
  metaDescription String?    @db.Text
  status          PageStatus @default(draft)
  publishedAt     DateTime?
  createdById     String?
  updatedById     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  createdBy User? @relation("CreatedPages", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("UpdatedPages", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@index([updatedById])
  @@index([status])
}

model MediaLibrary {
  id           String   @id @default(cuid())
  fileName     String
  filePath     String
  fileUrl      String?
  fileType     String?
  /// fileSize in bytes as Int
  fileSize     Int?
  mimeType     String?
  altText      String?
  uploadedById String?
  createdAt    DateTime @default(now())

  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([uploadedById])
}

/// =============================================================
/// SYSTEM LOGGING
/// =============================================================

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  entityType  String
  entityId    String?
  description String?  @db.Text
  ipAddress   String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  adminUserId String
  action      String
  targetType  String
  targetId    String?
  beforeJson  Json?
  afterJson   Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  adminUser User @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([createdAt])
}
