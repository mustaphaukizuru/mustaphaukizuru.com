  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

/// DEPRECATED (2026-08) · feature removed from the app; no code reads or writes this table.
/// Kept so `prisma db push` does not drop production data. Drop in a dedicated,
/// backed-up migration once you have confirmed nothing else depends on it.
model AdminPermission {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  createdAt DateTime @default(now())

  rolePermissions RolePermission[]
}

/// DEPRECATED (2026-08) · feature removed from the app; no code reads or writes this table.
/// Kept so `prisma db push` does not drop production data. Drop in a dedicated,
/// backed-up migration once you have confirmed nothing else depends on it.
model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
