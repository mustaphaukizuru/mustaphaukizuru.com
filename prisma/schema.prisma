/// =============================================================
/// PRISMA CLIENT + DATABASE CONNECTION
/// =============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// =============================================================
/// ENUMS
/// =============================================================

enum UserStatus {
  active
  suspended
  pending
}

enum CartStatus {
  active
  converted
  abandoned
}

enum OrderStatus {
  pending
  paid
  failed
  cancelled
  refunded
}

enum PaymentStatus {
  pending
  paid
  failed
  cancelled
  refunded
}

enum PaymentGateway {
  mercadopago
  paypal
}

enum ProductStatus {
  draft
  published
  archived
}

enum ServiceStatus {
  draft
  published
  archived
}

enum ItemType {
  product
  service
}

enum DownloadAccessStatus {
  active
  revoked
}

enum ServiceOrderStatus {
  new
  active
  on_hold
  completed
  cancelled
}

enum ConsultationStatus {
  pending
  confirmed
  scheduled
  completed
  cancelled
  rescheduled
  no_show
}

enum AvailabilityExceptionType {
  block
  custom
}

enum MeetingProvider {
  google_meet
  zoom
  manual
}

/// Refund lifecycle states. Mirror the gateway-agnostic values the
/// refundService writes/reads (src/services/refundService.js).
/// Pre-Phase-9 this column was a free-form String — any typo could
/// silently land in the row. The enum is value-compatible: every
/// string the service ever wrote falls inside this set.
enum RefundStatus {
  pending
  approved
  processing
  succeeded
  failed
}

enum ProjectStatus {
  planning
  in_progress
  review
  completed
  cancelled
}

enum MilestoneStatus {
  pending
  in_progress
  completed
}

enum TicketStatus {
  open
  in_progress
  resolved
  closed
}

enum TicketPriority {
  low
  medium
  high
}

/// SupportTicket category — drives admin UX (e.g. refund_request tickets get
/// a "View order" + "Open refund modal" deep-link on AdminSupportPage).
enum TicketCategory {
  general
  billing
  technical
  refund_request
  feature_request
  other
}

enum SenderRole {
  member
  admin
  system
}

enum DiscountType {
  percentage
  fixed
}

enum PageStatus {
  draft
  published
}

enum PageType {
  public
  legal
  landing
}

enum ProductImageRole {
  cover
  preview
  detail
  usage
  feature
  extra
}

enum PortfolioStatus {
  draft
  published
  archived
}

/// =============================================================
/// USERS
/// =============================================================

/// Step 42 · schema tidy. Named AccountRole (not UserRole) because a
/// `UserRole` join model already exists in this schema.
enum AccountRole {
  member
  admin
}

enum ContactMessageStatus {
  new
  read
  replied
}

enum NewsletterStatus {
  pending
  subscribed
  unsubscribed
}

enum CampaignRecipientStatus {
  queued
  sent
  failed
  bounced
}

enum DiagnosticAudience {
  EDU
  SMB
  IND
}

enum DiagnosticTier {
  Foundation
  Stabilizing
  Optimizing
  Mature
}

model User {
  id                     String           @id @default(cuid())
  fullName               String
  email                  String           @unique
  passwordHash           String?
  role                   AccountRole      @default(member)
  googleId               String?          @unique
  microsoftId            String?          @unique
  facebookId             String?          @unique
  avatarUrl              String?
  authProvider           String           @default("local")
  phone                  String?
  company                String?
  status                 UserStatus       @default(active)
  emailVerifiedAt        DateTime?
  lastLoginAt            DateTime?
  /// Token-revocation watermark. Any JWT with iat < tokensValidFrom is
  /// rejected by authMiddleware. Set whenever a credential changes (password
  /// reset, 2FA enable) or when the user manually signs out everywhere.
  /// NULL means "no revocations yet" — all valid JWTs pass.
  tokensValidFrom        DateTime?
  resetPasswordToken     String?
  resetPasswordExpires   DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  profile                UserProfile?
  userRoles              UserRole[]
  sessions               Session[]
  authOtps               AuthOtp[]
  passwordResets         PasswordReset[]
  orders                 Order[]
  carts                  Cart[]
  payments               Payment[]
  couponsUsed            CouponUsage[]
  reviews                Review[]         @relation("AuthoredReviews")
  adminReplies           Review[]         @relation("AdminReviewReplies")
  reviewVotes            ReviewVote[]
  createdRecommendations Recommendation[] @relation("CreatedRecommendations")
  downloadLogs           DownloadLog[]
  userDownloads          UserDownload[]
  createdProducts        Product[]        @relation("CreatedProducts")
  createdServices        Service[]        @relation("CreatedServices")
  createdPortfolios      Portfolio[]      @relation("CreatedPortfolios")
  serviceOrders          ServiceOrder[]
  consultations          Consultation[]   @relation("UserConsultations")
  assignedConsultations  Consultation[]   @relation("AssignedConsultations")
  clientProjects         ClientProject[]  @relation("UserClientProjects")
  assignedProjects       ClientProject[]  @relation("AssignedClientProjects")
  projectFiles           ProjectFile[]
  supportTickets         SupportTicket[]  @relation("UserSupportTickets")
  assignedTickets        SupportTicket[]  @relation("AssignedSupportTickets")
  supportMessages        SupportMessage[]
  notifications          Notification[]
  emailLogs              EmailLog[]
  uploadedMedia          MediaLibrary[]
  createdPages           Page[]           @relation("CreatedPages")
  updatedPages           Page[]           @relation("UpdatedPages")
  activityLogs           ActivityLog[]
  adminAuditLogs         AdminAuditLog[]
  wishlist               Wishlist?
  addresses              Address[]
  twoFactorAuth          TwoFactorAuth?

  // Booking — host-side relations (used when this user is the consultation host)
  hostAvailabilityRules      AvailabilityRule[]      @relation("HostAvailabilityRules")
  hostAvailabilityExceptions AvailabilityException[] @relation("HostAvailabilityExceptions")
}

model UserProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  companyName  String?
  jobTitle     String?
  country      String?
  city         String?
  addressLine1 String?
  addressLine2 String?
  stateRegion  String?
  postalCode   String?
  bio          String?  @db.Text
  timezone     String?
  websiteUrl   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthOtp {
  id        String    @id @default(cuid())
  userId    String?
  email     String
  otpCode   String
  purpose   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([email])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  token     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Session {
  id             String   @id @default(cuid())
  userId         String
  ipAddress      String?
  userAgent      String?  @db.Text
  deviceName     String?
  lastActivityAt DateTime @default(now())
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// DEPRECATED (2026-08) · feature removed from the app; no code reads or writes this table.
/// Kept so `prisma db push` does not drop production data. Drop in a dedicated,
/// backed-up migration once you have confirmed nothing else depends on it.
model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?  @db.Text
  createdAt   DateTime @default(now())

  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

/// DEPRECATED (2026-08) · feature removed from the app; no code reads or writes this table.
/// Kept so `prisma db push` does not drop production data. Drop in a dedicated,
/// backed-up migration once you have confirmed nothing else depends on it.
model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

/// DEPRECATED (2026-08) · feature removed from the app; no code reads or writes this table.
/// Kept so `prisma db push` does not drop production data. Drop in a dedicated,
/// backed-up migration once you have confirmed nothing else depends on it.
model AdminPermission {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  createdAt DateTime @default(now())

  rolePermissions RolePermission[]
}

/// DEPRECATED (2026-08) · feature removed from the app; no code reads or writes this table.
/// Kept so `prisma db push` does not drop production data. Drop in a dedicated,
/// backed-up migration once you have confirmed nothing else depends on it.
model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

/// =============================================================
/// PRODUCTS
/// =============================================================

model ProductCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?  @db.Text
  icon        String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Product {
  id                 String        @id @default(cuid())
  categoryId         String?
  title              String
  slug               String        @unique
  shortDescription   String?       @db.Text
  description        String?       @db.Text
  fullDescription    String?       @db.Text
  price              Decimal       @db.Decimal(12, 2)
  currency           String        @default("MXN")
  productType        String        @default("downloadable")
  status             ProductStatus @default(draft)
  sku                String?       @unique
  category           String?
  isActive           Boolean       @default(true)
  isFeatured         Boolean       @default(false)
  isNew              Boolean       @default(false)
  downloadUrl        String?
  fileName           String?
  /// fileSize stored as Int (supports files up to 2GB)
  fileSize           Int?
  fileType           String?
  version            String?
  /// Etsy-style key/value highlights, e.g. [{"key":"Page size","value":"8.5x11"}]
  titleEs            String?
  shortDescriptionEs String?       @db.Text
  descriptionEs      String?       @db.Text
  fullDescriptionEs  String?       @db.Text
  metaTitleEs        String?
  metaDescriptionEs  String?       @db.Text
  specifications     Json?
  /// Product FAQs as JSON: [{"question":"...","answer":"..."}, ...]
  productFaqs        Json?
  metaTitle          String?
  metaDescription    String?       @db.Text
  publishedAt        DateTime?
  createdById        String?
  rating             Float         @default(0)
  reviewCount        Int           @default(0)
  /// Step 42 · soft delete. Non-null = hidden from every public read.
  deletedAt          DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  categoryRef     ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy       User?            @relation("CreatedProducts", fields: [createdById], references: [id], onDelete: SetNull)
  images          ProductImage[]
  files           ProductFile[]
  features        ProductFeature[]
  orderItems      OrderItem[]
  downloadLogs    DownloadLog[]
  userDownloads   UserDownload[]
  tags            ProductTagMap[]
  reviews         Review[]
  recommendations Recommendation[]
  cartItems       CartItem[]
  wishlistItems   WishlistItem[]

  @@index([categoryId])
  @@index([createdById])
  @@index([status])
  @@index([isActive])
  @@index([isFeatured])
  @@index([deletedAt])
}

model ProductFeature {
  id          String @id @default(cuid())
  productId   String
  featureText String @db.Text
  sortOrder   Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductFile {
  id                  String   @id @default(cuid())
  productId           String
  fileName            String
  filePath            String
  fileType            String?
  /// fileSize in bytes as Int
  fileSize            Int?
  version             String?
  isPrimary           Boolean  @default(false)
  maxDownloadsPerUser Int?
  uploadedAt          DateTime @default(now())

  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  downloadLogs DownloadLog[]

  @@index([productId])
}

model ProductImage {
  id        String           @id @default(cuid())
  productId String
  url       String
  altText   String?
  imageRole ProductImageRole @default(cover)
  isPrimary Boolean          @default(false)
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

/// DEPRECATED (2026-08) · feature removed from the app; no code reads or writes this table.
/// Kept so `prisma db push` does not drop production data. Drop in a dedicated,
/// backed-up migration once you have confirmed nothing else depends on it.
model ProductTag {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  products ProductTagMap[]
}

/// DEPRECATED (2026-08) · feature removed from the app; no code reads or writes this table.
/// Kept so `prisma db push` does not drop production data. Drop in a dedicated,
/// backed-up migration once you have confirmed nothing else depends on it.
model ProductTagMap {
  id        String @id @default(cuid())
  productId String
  tagId     String

  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     ProductTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([productId, tagId])
  @@index([productId])
  @@index([tagId])
}

/// =============================================================
/// REVIEW — unified model for product AND service reviews.
/// Backed by the legacy `product_reviews` table via @@map; existing rows
/// keep their ids and content. New nullable columns (status, serviceId,
/// adminReply, etc.) are populated lazily as reviews are interacted with.
/// =============================================================
enum ReviewStatus {
  pending // awaiting moderation
  approved // visible publicly
  hidden // admin took it down (still in DB for audit)
  flagged // auto-mod or community flagged for human review
  rejected // admin explicitly rejected; soft-deleted
}

model Review {
  id                 String       @id @default(cuid())
  /// Discriminator — "product" or "service". Lets us treat reviews
  /// uniformly without polymorphic FK juggling.
  subjectType        String       @default("product") @db.VarChar(16)
  productId          String?
  serviceId          String?
  /// The OrderItem that produced this review (anti-fake-review pin).
  /// Required for verified-purchase reviews; null for legacy / unverified.
  orderItemId        String?
  userId             String
  rating             Int
  reviewText         String?      @db.Text
  isVerifiedPurchase Boolean      @default(false)
  status             ReviewStatus @default(pending)
  flaggedReason      String?      @db.VarChar(120)

  /// Admin reply — public, displayed under the review on the product/service page.
  adminReply     String?   @db.Text
  adminReplyAt   DateTime?
  adminReplyById String?

  /// Engagement signals (Sprint 1 wires storage; UI lands in Sprint 2)
  helpfulCount Int @default(0)

  /// Curation (Sprint 3 surfaces these on Home/Services)
  featured      Boolean @default(false)
  featuredOrder Int?

  /// Trust transparency
  editedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product      Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)
  service      Service?     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  user         User         @relation("AuthoredReviews", fields: [userId], references: [id], onDelete: Cascade)
  adminReplyBy User?        @relation("AdminReviewReplies", fields: [adminReplyById], references: [id], onDelete: SetNull)
  orderItem    OrderItem?   @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  votes        ReviewVote[]

  @@index([productId])
  @@index([serviceId])
  @@index([userId])
  @@index([status])
  @@index([featured])
  // Hot path · public product page renders approved reviews newest-first.
  // The single-column [status] + [productId] indexes can't service the
  // ORDER BY createdAt DESC efficiently — this compound covers it.
  @@index([productId, status, createdAt])
  @@map("product_reviews")
}

/// =============================================================
/// REVIEW VOTE — "Was this helpful?" tally with one vote per user.
/// =============================================================
model ReviewVote {
  id        String   @id @default(cuid())
  reviewId  String
  userId    String
  helpful   Boolean  @default(true)
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([reviewId])
  @@index([userId])
}

/// =============================================================
/// RECOMMENDATION — admin-curated picks (tools, books, partners,
/// templates, services). Surfaces on /recommendations and contextually
/// next to related products / services.
/// =============================================================
enum RecommendationStatus {
  draft
  published
  archived
}

/// DEPRECATED (2026-08) · feature removed from the app; no code reads or writes this table.
/// Kept so `prisma db push` does not drop production data. Drop in a dedicated,
/// backed-up migration once you have confirmed nothing else depends on it.
model Recommendation {
  id       String  @id @default(cuid())
  title    String
  slug     String  @unique
  summary  String  @db.Text
  body     String? @db.Text // markdown
  imageUrl String? @db.VarChar(512)
  category String  @default("tool") @db.VarChar(48)
  /// tool | book | course | template | service | partner

  priority Int                  @default(0) // sort, higher = earlier
  status   RecommendationStatus @default(draft)

  /// Optional internal links — at most one of these should be set.
  productId   String?
  serviceId   String?
  externalUrl String? @db.VarChar(512)

  /// Disclosure flag — surfaces "(affiliate)" on the public card.
  isAffiliate Boolean @default(false)

  /// SEO
  metaTitle       String? @db.VarChar(180)
  metaDescription String? @db.Text

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  createdBy User?    @relation("CreatedRecommendations", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([category])
  @@index([priority])
  @@index([productId])
  @@index([serviceId])
}

/// =============================================================
/// SERVICES
/// =============================================================

model Service {
  id               String        @id @default(cuid())
  title            String
  slug             String        @unique
  shortDescription String        @db.Text
  fullDescription  String?       @db.Text
  basePrice        Decimal       @default(0.00) @db.Decimal(12, 2)
  currency         String        @default("MXN")
  deliveryType     String
  status           ServiceStatus @default(draft)
  isFeatured       Boolean       @default(false)
  metaTitle        String?
  metaDescription  String?       @db.Text
  createdById      String?
  /// Step 42 · soft delete. Non-null = hidden from every public read.
  deletedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  /// Audience grouping for the public Choose-Your-Plan matrix.
  /// "professional" | "business" | "schools" — null for non-audience services.
  audienceCode String? @db.VarChar(32)

  /// =========================================================
  /// BOOKING POLICY — controls public consultation booking
  /// =========================================================
  /// When isBookable=true, the public booking calendar exposes this service.
  /// All time fields are interpreted in the host's timezone (per AvailabilityRule).
  isBookable             Boolean @default(false)
  bookingDurationMin     Int     @default(30)
  bookingBufferMin       Int     @default(15)
  bookingMinNoticeHours  Int     @default(24)
  bookingMaxAdvanceDays  Int     @default(60)
  bookingRequiresPayment Boolean @default(false)
  /// Booking Hardening v1 · per-service cancel/reschedule notice windows.
  /// Replace the previous hardcoded 12h gate in consultationService.
  /// Members cannot cancel within `bookingCancellationNoticeHours` of start,
  /// nor reschedule within `bookingRescheduleNoticeHours`. Admins bypass.
  bookingCancellationNoticeHours Int @default(12)
  bookingRescheduleNoticeHours   Int @default(12)

  createdBy          User?              @relation("CreatedServices", fields: [createdById], references: [id], onDelete: SetNull)
  features           ServiceFeature[]
  packages           ServicePackage[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  serviceOrders      ServiceOrder[]
  availabilityRules  AvailabilityRule[]
  consultations      Consultation[]
  reviews            Review[]
  recommendations    Recommendation[]
  titleEs            String?
  shortDescriptionEs String?            @db.Text
  descriptionEs      String?            @db.Text
  metaTitleEs        String?
  metaDescriptionEs  String?            @db.Text

  @@index([createdById])
  @@index([status])
  @@index([isBookable])
  @@index([audienceCode])
  @@index([deletedAt])
}

model ServiceFeature {
  id          String @id @default(cuid())
  serviceId   String
  featureText String @db.Text
  sortOrder   Int    @default(0)

  service Service              @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  slots   PackageFeatureSlot[]

  @@index([serviceId])
}

model ServicePackage {
  id          String   @id @default(cuid())
  serviceId   String
  name        String
  description String?  @db.Text
  price       Decimal  @db.Decimal(12, 2)
  currency    String   @default("MXN")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  /// Tier metadata for the public Choose-Your-Plan matrix.
  /// tierKey: "basic" | "medium" | "advanced"
  /// period:  "month" | "one-time" — display label only
  /// popular: shows the "Most Popular" badge
  /// saveLabel: small chip e.g. "Save 20%" / "All-inclusive"
  tierKey   String? @db.VarChar(32)
  period    String? @db.VarChar(32)
  popular   Boolean @default(false)
  saveLabel String? @db.VarChar(64)

  service       Service              @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceOrders ServiceOrder[]
  featureSlots  PackageFeatureSlot[]
  nameEs        String?
  descriptionEs String?              @db.Text

  @@index([serviceId])
  @@index([tierKey])
}

/// Join row mapping which Service Features are included in a given Package.
/// Drives the ✓/✗ matrix shown on the public Choose-Your-Plan page.
/// DEPRECATED (2026-08) · feature removed from the app; no code reads or writes this table.
/// Kept so `prisma db push` does not drop production data. Drop in a dedicated,
/// backed-up migration once you have confirmed nothing else depends on it.
model PackageFeatureSlot {
  id        String @id @default(cuid())
  packageId String
  featureId String

  package ServicePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  feature ServiceFeature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([packageId, featureId])
  @@index([packageId])
  @@index([featureId])
}

/// =============================================================
/// CART, ORDERS, PAYMENTS
/// =============================================================

model Cart {
  id              String     @id @default(cuid())
  userId          String?
  sessionToken    String?
  status          CartStatus @default(active)
  appliedCouponId String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user          User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         CartItem[]
  appliedCoupon Coupon?    @relation("CartAppliedCoupon", fields: [appliedCouponId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([sessionToken])
  @@index([appliedCouponId])
}

model CartItem {
  id            String   @id @default(cuid())
  cartId        String
  itemType      ItemType
  productId     String?
  serviceId     String?
  titleSnapshot String
  priceSnapshot Decimal  @db.Decimal(12, 2)
  quantity      Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cart    Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@index([productId])
  @@index([serviceId])
}

model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique
  description   String?      @db.Text
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(12, 2)

  // Global caps
  usageLimit Int?
  usedCount  Int  @default(0)

  // B03 additions — per-user + minimum-order + stackable
  minOrderAmount Decimal? @db.Decimal(12, 2)
  maxUsesPerUser Int?
  stackable      Boolean  @default(true)

  // Validity window
  startsAt  DateTime?
  expiresAt DateTime?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  orders       Order[]
  usages       CouponUsage[]
  appliedCarts Cart[]        @relation("CartAppliedCoupon")
}

model CouponUsage {
  id       String   @id @default(cuid())
  couponId String
  userId   String
  orderId  String?
  usedAt   DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([userId])
  @@index([orderId])
}

model Order {
  id                      String      @id @default(cuid())
  orderNumber             String      @unique
  userId                  String?
  customerName            String
  customerEmail           String
  billingName             String?
  billingEmail            String?
  billingPhone            String?
  billingCountry          String?
  billingCity             String?
  billingStateRegion      String?
  billingPostalCode       String?
  status                  OrderStatus @default(pending)
  subtotalAmount          Decimal     @default(0.00) @db.Decimal(12, 2)
  discountAmount          Decimal     @default(0.00) @db.Decimal(12, 2)
  serviceFeeAmount        Decimal     @default(0.00) @db.Decimal(12, 2)
  totalAmount             Decimal     @db.Decimal(12, 2)
  currency                String      @default("MXN")
  couponId                String?
  termsAcceptedAt         DateTime?
  mercadoPagoPreferenceId String?
  paidAt                  DateTime?
  notes                   String?     @db.Text
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  coupon         Coupon?         @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  invoices       Invoice[]
  payments       Payment[]
  refunds        Refund[]
  downloadLogs   DownloadLog[]
  userDownloads  UserDownload[]
  couponUsages   CouponUsage[]
  serviceOrders  ServiceOrder[]
  /// M16 — refund-request tickets opened by the customer reference back here.
  supportTickets SupportTicket[]

  @@index([userId])
  @@index([couponId])
  @@index([status])
  @@index([createdAt])
  @@index([userId, status]) // compound: member dashboard filter by user+status
  @@index([status, createdAt]) // compound: admin order list sorted by date+status
}

model OrderItem {
  id                  String   @id @default(cuid())
  orderId             String
  itemType            ItemType @default(product)
  productId           String?
  serviceId           String?
  title               String
  titleSnapshot       String?
  descriptionSnapshot String?  @db.Text
  price               Decimal? @db.Decimal(12, 2)
  unitPrice           Decimal? @db.Decimal(12, 2)
  quantity            Int
  lineTotal           Decimal? @db.Decimal(12, 2)
  createdAt           DateTime @default(now())

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  service       Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  userDownloads UserDownload[]
  serviceOrders ServiceOrder[]
  reviews       Review[]

  @@index([orderId])
  @@index([productId])
  @@index([serviceId])
  @@index([orderId, productId]) // compound: entitlement lookup
}

model Invoice {
  id            String   @id @default(cuid())
  orderId       String
  invoiceNumber String   @unique
  invoicePdfUrl String?
  issuedAt      DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId])
  @@index([orderId])
}

model Payment {
  id                   String         @id @default(cuid())
  orderId              String
  userId               String
  paymentGateway       PaymentGateway
  gatewayTransactionId String
  gatewaySessionId     String?
  amount               Decimal        @db.Decimal(12, 2)
  currency             String         @default("MXN")
  paymentStatus        PaymentStatus  @default(pending)
  failureReason        String?        @db.Text
  paidAt               DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  refunds Refund[]

  // Idempotency: one Payment per (gateway, gatewayTransactionId).
  // Prevents duplicate Payment rows from racing webhook + capture-callback
  // deliveries. Composite chosen because gatewayTransactionId is only
  // unique within a single gateway namespace.
  @@unique([paymentGateway, gatewayTransactionId], name: "payment_gateway_tx_uq")
  @@index([orderId])
  @@index([userId])
}

model PaymentWebhook {
  id             String         @id @default(cuid())
  paymentGateway PaymentGateway
  gatewayEventId String? // x-request-id (MP) or event.id (PayPal); null = couldn't extract
  eventType      String
  payloadJson    Json
  processed      Boolean        @default(false)
  processedAt    DateTime?
  createdAt      DateTime       @default(now())

  // Idempotency: drop duplicate webhook deliveries from the same gateway.
  // Nullable column means rows without an extractable event id are still
  // accepted (MySQL treats NULLs as distinct under UNIQUE).
  @@unique([paymentGateway, gatewayEventId], name: "webhook_event_uq")
  @@index([paymentGateway, processed])
}

model Refund {
  id           String       @id @default(cuid())
  paymentId    String
  orderId      String
  amount       Decimal      @db.Decimal(12, 2)
  reason       String?      @db.Text
  refundStatus RefundStatus
  processedAt  DateTime?
  createdAt    DateTime     @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([orderId])
}

/// =============================================================
/// DOWNLOADS
/// =============================================================

model UserDownload {
  id                   String               @id @default(cuid())
  userId               String
  productId            String
  orderId              String
  orderItemId          String
  downloadAccessStatus DownloadAccessStatus @default(active)
  downloadLimit        Int?
  downloadCount        Int                  @default(0)
  lastDownloadedAt     DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  logs      DownloadLog[]

  @@unique([userId, productId, orderItemId])
  @@index([userId])
  @@index([productId])
  @@index([orderId])
  @@index([orderItemId])
}

model DownloadLog {
  id             String   @id @default(cuid())
  userId         String
  productId      String
  orderId        String
  userDownloadId String?
  /// Per-file download cap tracking. Nullable so legacy rows (pre per-file cap)
  /// stay valid; downloadService falls back to productId for those.
  productFileId  String?
  userAgent      String?  @db.Text
  ipAddress      String?
  createdAt      DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userDownload UserDownload? @relation(fields: [userDownloadId], references: [id], onDelete: SetNull)
  productFile  ProductFile?  @relation(fields: [productFileId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([productId])
  @@index([orderId])
  @@index([userDownloadId])
  @@index([productFileId])
}

/// =============================================================
/// SERVICE DELIVERY
/// =============================================================

model ServiceOrder {
  id               String             @id @default(cuid())
  orderId          String
  orderItemId      String             @unique
  userId           String
  serviceId        String
  servicePackageId String?
  status           ServiceOrderStatus @default(new)
  startDate        DateTime?
  endDate          DateTime?
  notes            String?            @db.Text
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem      OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  service        Service         @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  servicePackage ServicePackage? @relation(fields: [servicePackageId], references: [id], onDelete: SetNull)
  consultations  Consultation[]
  clientProject  ClientProject?

  @@index([orderId])
  @@index([userId])
  @@index([serviceId])
  @@index([servicePackageId])
}

model Consultation {
  id                 String             @id @default(cuid())
  serviceOrderId     String? // null for free discovery calls (no prior payment)
  serviceId          String? // direct link when no serviceOrder; informs duration / category
  userId             String
  assignedAdminId    String? // host of the meeting; nullable until assigned
  scheduledAt        DateTime // UTC start time
  endsAt             DateTime? // UTC end time — derived on create from durationMin
  durationMin        Int                @default(30)
  timezone           String             @default("UTC") // client's IANA tz captured at booking
  meetingProvider    MeetingProvider    @default(manual)
  meetingLink        String? // join URL (Google Meet / Zoom / manual)
  /// Google Calendar event id — populated when meetingProvider = google_meet.
  /// Lets the reschedule / cancel paths update the same Calendar event
  /// instead of orphaning it. Nullable for non-Google bookings.
  googleEventId      String?
  status             ConsultationStatus @default(pending)
  summaryNotes       String?            @db.Text // host's post-meeting notes
  clientNotes        String?            @db.Text // client's pre-meeting notes / agenda
  cancellationReason String?            @db.Text
  cancelledAt        DateTime?
  confirmedAt        DateTime?
  completedAt        DateTime?
  /// Signed token for guest-style cancel/reschedule via email link without login.
  confirmationToken  String?            @unique
  /// Self-relation: when this row is a reschedule of a prior consultation.
  rescheduledFromId  String?
  /// Reminder bookkeeping — set when 24h or 1h reminder dispatched.
  reminderSentAt     DateTime?
  /// Monotonic revision counter. Starts at 0; incremented on every
  /// reschedule (the new row carries parent.revision + 1). Used as the
  /// ICS SEQUENCE so calendar clients (Gmail / Outlook / Apple Mail)
  /// recognise a real update across N reschedules instead of treating
  /// the 2nd+ reschedule as a duplicate of the 1st. RFC 5545 § 3.8.7.4.
  revision           Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  serviceOrder    ServiceOrder?  @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  service         Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  user            User           @relation("UserConsultations", fields: [userId], references: [id], onDelete: Cascade)
  assignedAdmin   User?          @relation("AssignedConsultations", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  rescheduledFrom Consultation?  @relation("ConsultationReschedule", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledTo   Consultation[] @relation("ConsultationReschedule")

  /// Race-safe booking. This database is MySQL, which has no EXCLUDE
  /// constraint, so same-start collisions per host are rejected at the DB
  /// level by this unique index (P2002 → 409 in consultationService).
  /// Overlap of different-length bookings is handled by the availability
  /// check in bookConsultation, which only offers non-overlapping slots.
  clientProject   ClientProject? @relation("ConsultationProject")

  @@unique([assignedAdminId, scheduledAt])
  @@index([serviceOrderId])
  @@index([serviceId])
  @@index([userId])
  @@index([assignedAdminId])
  @@index([scheduledAt])
  @@index([status])
  @@index([rescheduledFromId])
  // Hot path · booking calendar queries upcoming slots per service in a
  // date range. The single-column [serviceId] + [scheduledAt] indexes
  // can't service both predicates together; this compound covers it.
  @@index([serviceId, scheduledAt])
}

/// =============================================================
/// AVAILABILITY (booking calendar — recurring rules + exceptions)
/// =============================================================

model AvailabilityRule {
  id              String   @id @default(cuid())
  hostUserId      String // admin who owns this availability window
  serviceId       String? // null = applies to any bookable service
  dayOfWeek       Int // 0=Sunday … 6=Saturday (per JS Date.getDay)
  startTime       String // "HH:mm" 24-hour, interpreted in `timezone`
  endTime         String // "HH:mm" 24-hour, interpreted in `timezone`
  timezone        String // IANA tz, e.g. "America/Mexico_City"
  slotDurationMin Int      @default(30)
  bufferMin       Int      @default(0) // gap inserted after each generated slot
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  host    User     @relation("HostAvailabilityRules", fields: [hostUserId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([hostUserId])
  @@index([serviceId])
  @@index([dayOfWeek])
  @@index([isActive])
  // Hot path · slot generation filters all three predicates together
  // (active rules for this host on this weekday). Compound avoids a
  // table scan when the host has many historical/inactive rules.
  @@index([hostUserId, isActive, dayOfWeek])
}

model AvailabilityException {
  id         String                    @id @default(cuid())
  hostUserId String
  /// UTC midnight of the local exception date — interpretation uses `timezone`.
  date       DateTime
  type       AvailabilityExceptionType
  /// startTime/endTime required when type=custom (adds availability outside recurring rules).
  startTime  String?
  endTime    String?
  timezone   String
  reason     String?
  createdAt  DateTime                  @default(now())

  host User @relation("HostAvailabilityExceptions", fields: [hostUserId], references: [id], onDelete: Cascade)

  @@index([hostUserId])
  @@index([date])
  @@index([type])
}

model ClientProject {
  id              String        @id @default(cuid())
  serviceOrderId  String?       @unique
  /// Free consultations (no paid ServiceOrder) open a project shell too.
  consultationId  String?       @unique
  userId          String
  assignedAdminId String?
  projectName     String
  projectStatus   ProjectStatus @default(planning)
  startDate       DateTime?
  dueDate         DateTime?
  description     String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  serviceOrder  ServiceOrder?      @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  consultation  Consultation?      @relation("ConsultationProject", fields: [consultationId], references: [id], onDelete: SetNull)
  user          User               @relation("UserClientProjects", fields: [userId], references: [id], onDelete: Cascade)
  assignedAdmin User?              @relation("AssignedClientProjects", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  milestones    ProjectMilestone[]
  files         ProjectFile[]

  @@index([userId])
  @@index([assignedAdminId])
}

model ProjectMilestone {
  id          String          @id @default(cuid())
  projectId   String
  title       String
  description String?         @db.Text
  status      MilestoneStatus @default(pending)
  dueDate     DateTime?
  completedAt DateTime?
  sortOrder   Int             @default(0)

  project ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectFile {
  id           String   @id @default(cuid())
  projectId    String
  uploadedById String?
  fileName     String
  filePath     String
  fileType     String?
  createdAt    DateTime @default(now())

  project    ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User?         @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([uploadedById])
}

/// =============================================================
/// SUPPORT, CONTACT, NEWSLETTER
/// =============================================================

model SupportTicket {
  id              String         @id @default(cuid())
  ticketNumber    String         @unique
  userId          String
  subject         String
  /// Initial message body stored directly on ticket
  message         String         @db.Text
  status          TicketStatus   @default(open)
  priority        TicketPriority @default(medium)
  /// M16 — drives the admin "Open refund modal" deep-link on tickets that
  /// originated from a member-side refund request.
  category        TicketCategory @default(general)
  /// M16 — optional FK to an Order. Populated when the ticket was created
  /// via the "Request refund" flow on DashboardOrders so admins can jump
  /// straight to AdminOrderDetail without copy-pasting the order number.
  orderId         String?
  assignedAdminId String?
  resolvedAt      DateTime?
  closedAt        DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user          User             @relation("UserSupportTickets", fields: [userId], references: [id], onDelete: Cascade)
  assignedAdmin User?            @relation("AssignedSupportTickets", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  order         Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  messages      SupportMessage[]

  @@index([userId])
  @@index([assignedAdminId])
  @@index([status])
  @@index([category])
  @@index([orderId])
}

model SupportMessage {
  id            String     @id @default(cuid())
  ticketId      String
  senderId      String
  /// message body
  message       String     @db.Text
  senderRole    SenderRole @default(member)
  attachmentUrl String?
  isRead        Boolean    @default(false)
  createdAt     DateTime   @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User          @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([senderId])
}

/// Self-audit diagnostic submissions.
/// Created when a visitor completes the /self-audit tool and clicks
/// "Email my report". Persisted before the outbound email is sent so
/// leads are never lost on SMTP failure.
model DiagnosticSubmission {
  id              String   @id @default(cuid())
  name            String
  email           String
  organization    String?
  audience        DiagnosticAudience
  overallScore    Int      // 0-100 normalised
  tier            DiagnosticTier
  sectionScores   Json     // { A: { pct, raw, max }, ... }
  scores          Json     // raw { "A.1": 3, ... }
  topPriorities   Json     // [{id,svc,title,score,tier}]
  matchedBundle   String?  // Solution bundle name or null
  emailSent       Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([email])
  @@index([audience])
  @@index([createdAt])
}

model ContactMessage {
  id        String    @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String    @db.Text
  status    ContactMessageStatus @default(new)
  repliedAt DateTime?
  createdAt DateTime  @default(now())
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  status         NewsletterStatus @default(subscribed)
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?

  // B07 · token-based unsubscribe + attribution
  unsubscribeToken String? @unique
  source           String?
  name             String?
}

/// =============================================================
/// NOTIFICATIONS AND EMAILS
/// =============================================================

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String    @db.Text
  isRead    Boolean   @default(false)
  readAt    DateTime?
  linkUrl   String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model EmailTemplate {
  id        String   @id @default(cuid())
  key       String
  subject   String
  htmlBody  String   @db.LongText
  textBody  String?  @db.LongText
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
  locale    String   @default("en")

  @@unique([key, locale])
  @@index([locale])
}

/// Delivery state of one EmailLog row (roadmap step 41 · single email layer).
enum EmailStatus {
  queued
  sent
  failed
  bounced
  skipped
}

model EmailLog {
  id                String      @id @default(cuid())
  userId            String?
  emailTo           String
  templateKey       String?
  subject           String
  status            EmailStatus @default(queued)
  providerMessageId String?
  sentAt            DateTime?
  errorMessage      String?     @db.Text
  /// Number of delivery attempts made so far (1 after the first send).
  attempts          Int         @default(0)
  /// When the retry job may re-attempt delivery. Null = no retry scheduled.
  nextAttemptAt     DateTime?
  /// Stored mail options (from/to/subject/html/text/headers/ics) so the
  /// retry job can re-send without re-rendering. Null for permanent rows.
  payload           Json?
  createdAt         DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status, nextAttemptAt])
}

/// =============================================================
/// CMS AND MEDIA
/// =============================================================

/// DEPRECATED (2026-08) · feature removed from the app; no code reads or writes this table.
/// Kept so `prisma db push` does not drop production data. Drop in a dedicated,
/// backed-up migration once you have confirmed nothing else depends on it.
model Page {
  id              String     @id @default(cuid())
  title           String
  slug            String     @unique
  pageType        PageType   @default(public)
  contentJson     Json?
  contentHtml     String?    @db.LongText
  excerpt         String?    @db.Text
  metaTitle       String?
  metaDescription String?    @db.Text
  status          PageStatus @default(draft)
  publishedAt     DateTime?
  createdById     String?
  updatedById     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  createdBy         User?   @relation("CreatedPages", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy         User?   @relation("UpdatedPages", fields: [updatedById], references: [id], onDelete: SetNull)
  titleEs           String?
  contentEs         String? @db.Text
  metaTitleEs       String?
  metaDescriptionEs String? @db.Text

  @@index([createdById])
  @@index([updatedById])
  @@index([status])
}

model MediaLibrary {
  id           String   @id @default(cuid())
  fileName     String
  filePath     String
  fileUrl      String?
  fileType     String?
  /// fileSize in bytes as Int
  fileSize     Int?
  mimeType     String?
  altText      String?
  uploadedById String?
  createdAt    DateTime @default(now())

  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([uploadedById])
}

/// =============================================================
/// SYSTEM LOGGING
/// =============================================================

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  entityType  String
  entityId    String?
  description String?  @db.Text
  ipAddress   String?
  createdAt   DateTime @default(now())

