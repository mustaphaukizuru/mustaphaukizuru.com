model Portfolio {
  id               String          @id @default(cuid())
  title            String
  slug             String          @unique
  role             String
  client           String?
  category         String
  coverImage       String?
  gallery          Json?
  shortDescription String          @db.Text
  description      String?         @db.Text
  challenge        String?         @db.Text
  solution         String?         @db.Text
  results          Json?
  tools            Json?
  tags             Json?
  liveUrl          String?
  repoUrl          String?
  year             Int?
  duration         String?
  status           PortfolioStatus @default(published)
  isFeatured       Boolean         @default(false)
  displayOrder     Int             @default(0)
  metaTitle        String?
  metaDescription  String?         @db.Text
  createdById      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  createdBy          User?   @relation("CreatedPortfolios", fields: [createdById], references: [id], onDelete: SetNull)
  titleEs            String?
  shortDescriptionEs String? @db.Text
  descriptionEs      String? @db.Text
  metaTitleEs        String?
