  id          String   @id @default(cuid())
  name        String   @unique
  description String?  @db.Text
  createdAt   DateTime @default(now())

  userRoles       UserRole[]
  rolePermissions RolePermission[]
}

/// DEPRECATED (2026-08) · feature removed from the app; no code reads or writes this table.
